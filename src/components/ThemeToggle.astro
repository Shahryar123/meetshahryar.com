---
/**
 * Switches between light and dark. Until the visitor picks one, the OS
 * preference decides; the choice is then saved and applied before paint
 * by the inline script in BaseLayout.
 */
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';

interface Props {
  /** Show a text label next to the icon (used in the mobile menu). */
  withLabel?: boolean;
}
const { withLabel = false } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch theme"
  class:list={[
    'inline-flex min-h-10 items-center gap-2 rounded-chip text-muted hover:text-ink',
    withLabel ? 'btn btn-secondary' : 'min-w-10 justify-center',
  ]}
>
  <span class="when-dark">
    <Sun size={20} stroke-width={1.75} aria-hidden="true" />
  </span>
  <span class="when-light">
    <Moon size={20} stroke-width={1.75} aria-hidden="true" />
  </span>
  {withLabel && (
    <span data-theme-label class="text-ink">
      Switch theme
    </span>
  )}
</button>

<style is:global>
  /* The icon shows the theme you'll switch to. */
  .when-dark,
  .when-light {
    display: inline-flex;
  }
  .when-light {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .when-dark {
      display: none;
    }
    :root:not([data-theme='dark']) .when-light {
      display: inline-flex;
    }
  }
  :root[data-theme='light'] .when-dark {
    display: none;
  }
  :root[data-theme='light'] .when-light {
    display: inline-flex;
  }

  /*
   * Theme switch: a view transition where the new theme comes down from the
   * top behind a soft edge, over a still snapshot of the old one.
   * The mask is 2.25× the page tall: opaque top, a 0.25-page soft band,
   * transparent bottom. Sliding it from bottom-aligned to top-aligned sweeps
   * the band down the screen. Scoped to data-theme-switch, so Astro's page
   * navigation transitions are untouched.
   */
  html[data-theme-switch]::view-transition-old(root) {
    animation: none;
  }
  html[data-theme-switch]::view-transition-new(root) {
    animation: theme-sweep-down 0.9s cubic-bezier(0.65, 0, 0.35, 1) both;
    mask-image: linear-gradient(to bottom, #000 44.5%, transparent 55.5%);
    mask-size: 100% 225%;
    mask-repeat: no-repeat;
  }
  @keyframes theme-sweep-down {
    from {
      mask-position: 0 100%;
    }
    to {
      mask-position: 0 0;
    }
  }
</style>

<script>
  const KEY = 'theme';
  const media = matchMedia('(prefers-color-scheme: light)');

  const current = (): 'light' | 'dark' => {
    const set = document.documentElement.dataset.theme;
    if (set === 'light' || set === 'dark') return set;
    return media.matches ? 'light' : 'dark';
  };

  function sync() {
    const next = current() === 'dark' ? 'light' : 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-label', `Switch to ${next} theme`);
      const label = button.querySelector('[data-theme-label]');
      if (label) label.textContent = next === 'light' ? 'Light theme' : 'Dark theme';
    });
  }

  function apply(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem(KEY, theme);
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
    sync();
  }

  function init() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        const root = document.documentElement;
        const animate =
          'startViewTransition' in document &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!animate) {
          apply(next);
          return;
        }
        // The new theme sweeps down from the top (styles above). Browsers
        // without view transitions, and reduced motion, switch instantly.
        root.dataset.themeSwitch = `to-${next}`;
        const transition = document.startViewTransition(() => apply(next));
        transition.finished.finally(() => delete root.dataset.themeSwitch);
      });
    });
    sync();
  }

  document.addEventListener('astro:page-load', init);
  // Keep the chosen theme across view-transition navigations.
  document.addEventListener('astro:before-swap', (event) => {
    const theme = document.documentElement.dataset.theme;
    if (theme) event.newDocument.documentElement.dataset.theme = theme;
  });
  media.addEventListener('change', sync);
</script>
