---
import { getCollection } from 'astro:content';
import Eyebrow from '@/components/Eyebrow.astro';
import Photo from '@/components/Photo.astro';
import T from '@/components/T.astro';
import { byOrder } from '@/lib/format';
import { getSite } from '@/lib/site';

const site = await getSite();
// The current role comes from Experience (the newest entry still running), so the two never disagree.
const current = (await getCollection('experience'))
  .filter((job) => job.data.end === 'present')
  .sort(byOrder)[0];
---

<section id="about" aria-labelledby="about-title" class="shell section-gap">
  <div class="grid grid-cols-12 gap-x-6 gap-y-10">
    <div class="col-span-12 sm:col-span-6 md:col-span-5 lg:col-span-4">
      <!-- The oval portrait (src/assets/me.png), shown whole. -->
      <div class="about-photo">
        <Photo
          widths={[320, 480, 640]}
          sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 45vw, 20rem"
        />
      </div>
    </div>

    <div class="col-span-12 md:col-span-7 lg:col-span-7 lg:col-start-6">
      <hgroup>
        <Eyebrow label="Who I am" />
        <h2 id="about-title" class="type-h2 mt-3">
          About
        </h2>
      </hgroup>
      <div class="measure mt-8 space-y-5">
        {site.about.map((paragraph) => (
          <p>
            <T v={paragraph} />
          </p>
        ))}
      </div>

      {
        current && (
          <dl class="current mt-12">
            <dt class="current-label">Current position</dt>
            <dd class="mt-2">
              <span class="type-subhead block">{current.data.role}</span>
              <span class="text-muted">{current.data.company}</span>
            </dd>
          </dl>
        )
      }
    </div>
  </div>
</section>

<style>
  /* A tile with a signal bar on the left: the one fact a recruiter scans for. */
  .current {
    display: inline-block;
    padding: 1.25rem 1.5rem 1.25rem 1.25rem;
    border-left: 4px solid var(--signal);
    border-radius: var(--radius-node);
    background: var(--panel);
  }
  .current-label {
    color: var(--accent);
    font-size: 0.8125rem;
    font-stretch: 112%;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .about-photo {
    max-width: 20rem;
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 40rem) {
    .about-photo {
      max-width: none;
    }
  }
</style>
