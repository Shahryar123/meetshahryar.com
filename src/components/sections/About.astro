---
import { getCollection } from 'astro:content';
import aboutPhoto from '@/assets/me-about-section.png';
import Eyebrow from '@/components/Eyebrow.astro';
import Photo from '@/components/Photo.astro';
import T from '@/components/T.astro';
import { byOrder } from '@/lib/format';
import { getSite } from '@/lib/site';

const site = await getSite();
// The current role comes from Experience (the newest entry still running), so the two never disagree.
const current = (await getCollection('experience'))
  .filter((job) => job.data.end === 'present')
  .sort(byOrder)[0];
// Terminal user name: the surname, lower case ("shahryar").
const user = site.surname.toLowerCase();
---

<section id="about" aria-labelledby="about-title" class="shell section-gap">
  <div class="grid grid-cols-12 gap-x-6 gap-y-10">
    <div class="col-span-12 sm:col-span-6 md:col-span-5 lg:col-span-4">
      <!--
        The About photo (src/assets/me-about-section.png, a copy of public/me-about-section.png
        so Astro can compress it), an outline frame offset behind it, and the current
        role on a card over the corner. The frame follows the photo's own proportions.
      -->
      <div class="portrait">
        <span class="portrait-frame" aria-hidden="true"></span>
        <div
          class="portrait-photo"
          style={`aspect-ratio: ${aboutPhoto.width} / ${aboutPhoto.height}`}
        >
          <Photo
            image={aboutPhoto}
            widths={[360, 540, 720]}
            sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 45vw, 22rem"
          />
        </div>
        {
          current && (
            <dl class="current">
              <dt class="current-label">Current position</dt>
              <dd class="current-role">{current.data.role}</dd>
              <dd class="current-company">{current.data.company}</dd>
            </dl>
          )
        }
      </div>
    </div>

    <div class="col-span-12 md:col-span-7 lg:col-span-7 lg:col-start-6">
      <hgroup>
        <Eyebrow label="Who I am" />
        <h2 id="about-title" class="type-h2 mt-3">
          About
        </h2>
      </hgroup>
      <!--
        The About copy as a terminal session. All of it is real text (indexed and
        read out normally); only the prompts, window dots and cursor are decoration.
      -->
      <div class="terminal mt-8" role="group" aria-label="About me">
        <div class="terminal-bar" aria-hidden="true">
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-title">{user}@cloud: ~</span>
        </div>
        <div class="terminal-body">
          <p class="cmd"><span class="prompt" aria-hidden="true">$</span> whoami</p>
          <p class="out">
            <strong class="hl">{user}</strong>
            {current && (
              <>
                {' '}
                — {current.data.role} @ {current.data.company}
              </>
            )}
          </p>

          <p class="cmd"><span class="prompt" aria-hidden="true">$</span> cat about.md</p>
          <div class="out prose">
            {site.about.map((paragraph) => (
              <p>
                <T v={paragraph} />
              </p>
            ))}
          </div>

          <p class="cmd"><span class="prompt" aria-hidden="true">$</span> ls clouds/</p>
          <p class="out dirs">{site.clouds.map((c) => `${c}/`).join('  ')}</p>

          <p class="cmd"><span class="prompt" aria-hidden="true">$</span> cat setup.yml</p>
          <dl class="out yaml">
            {Object.entries(site.setup).map(([key, value]) => (
              <div>
                <dt>{key}:</dt>
                <dd>{Array.isArray(value) ? `[${value.join(', ')}]` : value}</dd>
              </div>
            ))}
          </dl>

          <p class="cmd" aria-hidden="true">
            <span class="prompt">$</span> <span class="cursor"></span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .portrait {
    position: relative;
    max-width: 22rem;
    /* room for the frame's offset, so it never touches the next column */
    margin: 0 1rem 1rem 0;
  }
  @media (min-width: 40rem) {
    .portrait {
      max-width: none;
    }
  }
  .portrait-frame {
    position: absolute;
    inset: 0;
    translate: 1rem 1rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-media);
  }
  .portrait-photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--panel);
  }

  /* The current role on a card over the photo's bottom-left corner. */
  .current {
    position: absolute;
    left: -0.75rem;
    bottom: 1.25rem;
    max-width: calc(100% - 1rem);
    padding: 0.875rem 1.125rem 0.875rem 1rem;
    border-radius: var(--radius-node);
    background: light-dark(#fff, var(--panel));
    box-shadow: 0 16px 32px -14px rgb(15 42 46 / 0.4);
    /* A slight tilt, as in the mock; it straightens on hover like the terminal. */
    rotate: -2.5deg;
    transition: rotate 0.5s var(--ease-out);
  }
  .portrait:hover .current {
    rotate: 0deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .current {
      transition: none;
    }
  }
  .current-label {
    color: var(--accent);
    font-size: 0.6875rem;
    line-height: 1.2;
    font-stretch: 112%;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .current-role {
    margin-top: 0.25rem;
    font-size: 1.0625rem;
    line-height: 1.2;
    font-stretch: 112%;
    font-weight: 750;
  }
  .current-company {
    margin-top: 0.125rem;
    color: color-mix(in oklab, var(--accent) 70%, var(--ink));
    font-size: 0.875rem;
  }
  @media (min-width: 64rem) {
    .current {
      left: -1rem;
      bottom: 1.5rem;
    }
  }

  /* --- Terminal: always dark, whatever the page theme --- */
  .terminal {
    color-scheme: dark; /* tokens inside resolve to their dark values */
    overflow: hidden;
    border-radius: var(--radius-node);
    background: var(--band);
    color: var(--muted);
    box-shadow: 0 30px 60px -28px rgb(15 42 46 / 0.6);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    transition: rotate 0.5s var(--ease-out);
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--panel);
  }
  .terminal-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: var(--radius-full);
    background: #ff5f57;
  }
  .terminal-dot:nth-child(2) {
    background: #febc2e;
  }
  .terminal-dot:nth-child(3) {
    background: #28c840;
  }
  .terminal-title {
    margin-left: 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .terminal-body {
    padding: 1.25rem 1.25rem 1.5rem;
    overflow-wrap: anywhere;
  }
  .cmd {
    color: var(--ink);
    font-weight: 600;
  }
  .cmd:not(:first-child) {
    margin-top: 1.125rem;
  }
  .prompt {
    color: var(--signal);
  }
  .out {
    margin-top: 0.125rem;
  }
  .hl {
    color: var(--ink);
    font-weight: 700;
  }
  .prose {
    color: color-mix(in oklab, var(--muted) 60%, var(--ink));
  }
  .prose p + p {
    margin-top: 0.625rem;
  }
  .dirs {
    color: var(--accent);
    white-space: pre;
  }
  .yaml dt {
    display: inline;
    color: var(--accent);
  }
  .yaml dd {
    display: inline;
    margin-left: 1ch;
    color: color-mix(in oklab, var(--muted) 40%, var(--ink));
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--signal);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 48rem) {
    .terminal {
      font-size: 0.875rem;
    }
    .terminal-body {
      padding: 1.5rem 1.75rem 1.75rem;
    }
  }
  /* A slight tilt on wide screens; it straightens on hover. */
  @media (min-width: 64rem) {
    .terminal {
      rotate: 1.5deg;
    }
    .terminal:hover {
      rotate: 0deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .terminal {
      transition: none;
    }
    .cursor {
      animation: none;
    }
  }
</style>
