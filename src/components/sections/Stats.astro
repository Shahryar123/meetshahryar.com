---
/**
 * Stats strip, right after Selected work: up to four headline numbers.
 * Edit the `stats` list below. Numbers count up once when scrolled into view
 * (skipped under prefers-reduced-motion; the final value is always in the HTML).
 */
import Eyebrow from '@/components/Eyebrow.astro';

interface Stat {
  value: number;
  suffix?: string;
  label: string;
  detail: string;
}

const stats: Stat[] = [
  { value: 15, suffix: '+', label: 'Projects delivered', detail: 'Migrations, pipelines and platforms' },
  { value: 5, suffix: '+', label: 'Happy clients', detail: 'Startups to enterprise teams' },
  { value: 6, suffix: '+', label: 'Years experience', detail: 'AWS, Azure and Kubernetes' },
  { value: 99.9, suffix: '%', label: 'Uptime achieved', detail: 'Across production workloads' },
].slice(0, 4);
---

<section id="stats" aria-labelledby="stats-title" class="stats-band section-gap offscreen-lazy">
  <div class="shell stats-inner">
    <hgroup class="stats-head">
      <Eyebrow label="By the numbers" tone="signal" />
      <h2 id="stats-title" class="type-h2 mt-3">Impact so far</h2>
    </hgroup>

    <ul role="list" class="stats-grid" style={`--count: ${stats.length}`}>
      {stats.map((s, i) => (
        <li class="stat" style={`--i: ${i}`}>
          <span class="stat-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p class="stat-value">
            <span
              class="stat-num"
              data-count={s.value}
              data-decimals={String(s.value).split('.')[1]?.length ?? 0}
            >
              {s.value}
            </span>
            {s.suffix && <span class="stat-suffix">{s.suffix}</span>}
          </p>
          <p class="stat-label">{s.label}</p>
          <p class="stat-detail">{s.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const nums = document.querySelectorAll<HTMLElement>('.stat-num[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce && 'IntersectionObserver' in window && nums.length) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals) || 0;
      const duration = 1600;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 4);
        el.textContent = (target * eased).toFixed(decimals);
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          el.closest('.stat')?.classList.add('is-in');
          run(el);
          io.unobserve(el);
        }
      },
      { threshold: 0.5 },
    );
    nums.forEach((el) => {
      el.textContent = (0).toFixed(Number(el.dataset.decimals) || 0);
      el.closest('.stat')?.classList.add('will-in');
      io.observe(el);
    });
  }
</script>

<style>
  .stats-band {
    background: var(--band);
  }
  .stats-inner {
    color-scheme: dark;
    color: var(--ink);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  @media (min-width: 64rem) {
    .stats-grid {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }
  }

  .stat {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem 1.5rem;
    border: 1px solid color-mix(in oklab, var(--rule) 45%, transparent);
    border-radius: var(--radius-node);
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in oklab, var(--signal) 10%, transparent), transparent 60%),
      var(--panel);
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out),
      opacity 0.6s var(--ease-out),
      translate 0.6s var(--ease-out);
  }
  /* Signal bar along the top that grows on hover. */
  .stat::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    height: 3px;
    width: 2.5rem;
    background: var(--signal);
    transition: width 0.5s var(--ease-out);
  }
  .stat:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--signal) 55%, transparent);
  }
  .stat:hover::before {
    width: 100%;
  }

  .stat-index {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    color: color-mix(in oklab, var(--muted) 60%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .stat-value {
    display: flex;
    align-items: baseline;
    gap: 0.125rem;
    color: var(--ink);
    font-size: clamp(2.75rem, 2rem + 2.5vw, 3.75rem);
    line-height: 1;
    font-stretch: 118%;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .stat-suffix {
    color: var(--signal);
    font-size: 0.6em;
    font-weight: 750;
  }

  .stat-label {
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-stretch: 112%;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .stat-detail {
    margin-top: 0.375rem;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Staggered entrance (only when JS armed it). */
  .stat.will-in {
    opacity: 0;
    translate: 0 1rem;
    transition-delay: calc(var(--i) * 90ms);
  }
  .stat.will-in.is-in {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .stat,
    .stat::before {
      transition: none;
    }
    .stat:hover {
      transform: none;
    }
  }
</style>
