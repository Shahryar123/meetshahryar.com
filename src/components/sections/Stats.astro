---
/**
 * Stats bento, right after Selected work. Edit the values below.
 * Numbers count up (and the visuals animate) when scrolled into view; the
 * Under prefers-reduced-motion everything is static
 * and the final values are always in the HTML.
 */
import Eyebrow from '@/components/Eyebrow.astro';

const uptime = { value: 99.9, label: 'Uptime achieved', detail: 'Across production workloads' };
const projects = { value: 15, label: 'Projects delivered', detail: 'Web apps, APIs and cloud platforms' };
const clients = { value: 5, label: 'Happy clients', detail: 'Startups to enterprise teams' };
const experience = {
  value: 5,
  label: 'Years experience',
  stack: ['.NET', 'React', 'AWS'],
};

/** Uptime bars: a few slightly lighter "blips" so it reads as a real status history. */
const bars = Array.from({ length: 60 }, (_, i) => ([9, 23, 41, 52].includes(i) ? 'blip' : 'ok'));
const decimals = (n: number) => String(n).split('.')[1]?.length ?? 0;
---

<section id="stats" aria-labelledby="stats-title" class="stats-band section-gap offscreen-lazy">
  <div class="shell stats-inner">
    <div class="stats-head">
      <hgroup>
        <Eyebrow label="By the numbers" tone="signal" />
        <h2 id="stats-title" class="type-section-display mt-3">Impact so far</h2>
      </hgroup>
    </div>

    <ul role="list" class="bento">
      {/* Uptime: the hero tile */}
      <li class="tile tile--uptime">
        <div class="tile-top">
          <span class="status"><span class="status-dot" aria-hidden="true"></span>All systems operational</span>
          <span class="tag">status / production</span>
        </div>
        <div class="uptime-body">
          <p class="num num--xl">
            <span data-count={uptime.value} data-decimals={decimals(uptime.value)}>{uptime.value}</span><span class="suffix">%</span>
          </p>
          <p class="label">{uptime.label}</p>
          <p class="detail">{uptime.detail}</p>
          <div class="bars" aria-hidden="true">
            {bars.map((b, i) => <span class:list={['bar', b]} style={`--i:${i}`} />)}
          </div>
        </div>
      </li>

      {/* Projects: yellow tile with one block per project */}
      <li class="tile tile--projects">
        <div>
          <span class="tag">01 / deployed</span>
          <p class="num num--lg">
            <span data-count={projects.value}>{projects.value}</span><span class="suffix">+</span>
          </p>
          <p class="label">{projects.label}</p>
          <p class="detail">{projects.detail}</p>
        </div>
        <div class="blocks" aria-hidden="true">
          {Array.from({ length: projects.value }, (_, i) => <span class="block" style={`--i:${i}`} />)}
        </div>
      </li>

      {/* Clients: avatar stack */}
      <li class="tile tile--clients">
        <span class="tag">02 / clients</span>
        <div class="avatars" aria-hidden="true">
          {Array.from({ length: clients.value }, (_, i) => (
            <span class="avatar" style={`--i:${i}`}>
              <svg viewBox="0 0 24 24" width="14" height="14"><path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M8 7h4M8 11h4M8 15h4M2 21h20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </span>
          ))}
          <span class="avatar avatar--more" style={`--i:${clients.value}`}>+</span>
        </div>
        <p class="num num--md">
          <span data-count={clients.value}>{clients.value}</span><span class="suffix">+</span>
        </p>
        <p class="label">{clients.label}</p>
        <p class="detail">{clients.detail}</p>
      </li>

      {/* Experience: light tile with a progress bar and stack chips */}
      <li class="tile tile--exp">
        <span class="tag">03 / experience</span>
        <p class="num num--md">
          <span data-count={experience.value}>{experience.value}</span><span class="suffix">+</span>
        </p>
        <p class="label">{experience.label}</p>
        <div class="progress" aria-hidden="true"><span></span></div>
        <ul role="list" class="chips">
          {experience.stack.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </li>
    </ul>
  </div>
</section>

<script>
  const section = document.getElementById('stats');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && !reduce && 'IntersectionObserver' in window) {
    const nums = section.querySelectorAll<HTMLElement>('[data-count]');
    const fmt = (el: HTMLElement, v: number) => v.toFixed(Number(el.dataset.decimals) || 0);

    const count = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / 1600, 1);
        el.textContent = fmt(el, target * (1 - Math.pow(1 - t, 4)));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const play = () => {
      section.classList.add('is-in');
      nums.forEach(count);
    };

    section.classList.add('will-in');
    nums.forEach((el) => (el.textContent = fmt(el, 0)));

    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          play();
          io.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(section.querySelector('.bento')!);
  }
</script>

<style>
  .stats-band {
    background: var(--band);
  }
  .stats-inner {
    color-scheme: dark;
    color: var(--ink);
    padding-block: clamp(4rem, 3rem + 4vw, 6rem);
  }
  .stats-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* --- Bento grid --- */
  .bento {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile--uptime,
    .tile--projects {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: 1.15fr 0.6fr 0.6fr;
      grid-template-rows: auto auto;
    }
    .tile--uptime {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .tile--projects {
      grid-column: 2 / span 2;
    }
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid color-mix(in oklab, var(--rule) 45%, transparent);
    border-radius: var(--radius-media);
    background: var(--panel);
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  .tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -20px rgb(0 0 0 / 0.6);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .num {
    display: flex;
    align-items: baseline;
    line-height: 0.95;
    font-stretch: 125%;
    font-weight: 850;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .num--xl {
    font-size: clamp(4.5rem, 3rem + 6vw, 8rem);
  }
  .num--lg {
    margin-top: 0.5rem;
    font-size: clamp(3.25rem, 2.5rem + 2.5vw, 4.5rem);
  }
  .num--md {
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: clamp(3rem, 2.5rem + 1.5vw, 4rem);
  }
  .suffix {
    margin-left: 0.15rem;
    color: var(--signal);
    font-size: 0.45em;
    font-weight: 750;
  }
  .label {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-stretch: 112%;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .detail {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* --- Uptime --- */
  .tile--uptime {
    background:
      radial-gradient(90% 60% at 0% 100%, color-mix(in oklab, #4fbf8a 10%, transparent), transparent 70%),
      #0b1f22;
  }
  .tile-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #6fd3a3;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .status-dot {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #4fbf8a;
    box-shadow: 0 0 0 4px color-mix(in oklab, #4fbf8a 25%, transparent);
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #4fbf8a;
    animation: ping 2s var(--ease-out) infinite;
  }
  @keyframes ping {
    to {
      scale: 2.8;
      opacity: 0;
    }
  }
  .uptime-body {
    margin-top: auto;
    padding-top: 3rem;
  }
  .bars {
    display: flex;
    gap: 3px;
    height: 2rem;
    margin-top: 1.5rem;
  }
  .bar {
    flex: 1;
    border-radius: 2px;
    background: #4fbf8a;
    transform-origin: bottom;
  }
  .bar.blip {
    background: #b9ecd2;
  }

  /* --- Projects --- */
  .tile--projects {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-color: var(--signal);
    background: var(--signal);
    color: var(--on-signal);
  }
  .tile--projects :is(.tag, .detail) {
    color: color-mix(in oklab, var(--on-signal) 75%, var(--signal));
  }
  .tile--projects .suffix {
    color: var(--on-signal);
  }
  .blocks {
    display: grid;
    grid-template-columns: repeat(5, 1.75rem);
    gap: 0.4rem;
  }
  @media (min-width: 40rem) {
    .blocks {
      grid-template-columns: repeat(5, 2.125rem);
    }
  }
  .block {
    aspect-ratio: 1;
    border-radius: 7px;
    background: var(--on-signal);
  }

  /* --- Clients --- */
  .avatars {
    display: flex;
    margin-top: 1rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    margin-left: -0.45rem;
    border: 2px solid var(--panel);
    border-radius: 50%;
    background: color-mix(in oklab, #2a8a7f calc(100% - var(--i) * 18%), var(--rule));
    color: #d9f0eb;
  }
  .avatar:first-child {
    margin-left: 0;
  }
  .avatar--more {
    background: var(--signal);
    color: var(--on-signal);
    font-weight: 800;
  }

  /* --- Experience (light tile) --- */
  .tile--exp {
    border-color: transparent;
    background: #e6efec;
    color: #0f2a2e;
  }
  .tile--exp .tag {
    color: #4a6662;
  }
  .tile--exp .suffix {
    color: #1f6f6a;
  }
  .progress {
    height: 6px;
    margin-top: 0.875rem;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, #0f2a2e 12%, transparent);
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #0f2a2e;
    transform-origin: left;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
  }
  .chip {
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-chip);
    background: #0f2a2e;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* --- Entrance animations (armed by JS) --- */
  .will-in .tile {
    opacity: 0;
    translate: 0 1.25rem;
  }
  .is-in .tile {
    animation: rise 0.7s var(--ease-out) both;
  }
  .is-in .tile:nth-child(2) { animation-delay: 80ms; }
  .is-in .tile:nth-child(3) { animation-delay: 160ms; }
  .is-in .tile:nth-child(4) { animation-delay: 240ms; }
  @keyframes rise {
    from { opacity: 0; translate: 0 1.25rem; }
    to { opacity: 1; translate: 0 0; }
  }

  .is-in .bar {
    animation: grow 0.5s var(--ease-out) both;
    animation-delay: calc(300ms + var(--i) * 12ms);
  }
  @keyframes grow {
    from { scale: 1 0; }
  }

  .is-in .block {
    animation: pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(350ms + var(--i) * 55ms);
  }
  @keyframes pop {
    from { scale: 0; opacity: 0; }
  }

  .is-in .avatar {
    animation: slide-in 0.5s var(--ease-out) both;
    animation-delay: calc(400ms + var(--i) * 90ms);
  }
  @keyframes slide-in {
    from { opacity: 0; translate: -0.75rem 0; }
  }

  .is-in .progress span {
    animation: fill 1.4s var(--ease-out) both 500ms;
  }
  @keyframes fill {
    from { scale: 0 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
    .tile:hover {
      transform: none;
    }
    .status-dot::after {
      animation: none;
    }
  }
</style>
