---
import { getCollection } from 'astro:content';
import Eyebrow from '@/components/Eyebrow.astro';
import T from '@/components/T.astro';
import { byOrder } from '@/lib/format';

const steps = (await getCollection('process')).sort(byOrder);
const intro =
  'How I take a cloud migration or DevOps project on AWS and Azure from first audit to a documented handover.';
---

<!--
  An always-dark band. The outer element paints the band (its colour follows the
  page theme); inside, color-scheme is dark, so every token resolves to its dark value.
-->
<section id="process" aria-labelledby="process-title" class="band section-gap">
  <div class="shell band-inner">
    <div class="process-head">
      <hgroup>
        <Eyebrow label="My process" tone="signal" />
        <h2 id="process-title" class="type-section-display mt-3">How I work</h2>
      </hgroup>
      <p class="process-intro type-lead">{intro}</p>
    </div>

    <!-- A real sequence, so the steps are numbered. -->
    <ol role="list" class="steps" style={`--steps: ${steps.length}`}>
      {steps.map((step, i) => (
        <li class="step" style={`--i: ${i}`}>
          <span class="step-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="step-card">
            <h3 class="step-title">{step.data.title}</h3>
            <p class="step-body mt-3">
              <T v={step.data.body} />
            </p>
            {step.data.outcome && (
              <p class="step-outcome">
                <span aria-hidden="true">→</span>
                <span class="sr-only">Outcome:</span>
                {step.data.outcome}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .band {
    background: var(--band);
  }
  .band-inner {
    color-scheme: dark;
    color: var(--ink);
    padding-block: clamp(4rem, 3rem + 4vw, 6rem);
  }

  .process-head {
    display: grid;
    gap: 1.5rem 3rem;
  }
  .process-intro {
    max-width: 30rem;
    color: var(--muted);
  }

  /* --- Steps: stacked with a vertical track (mobile and tablet) --- */
  .steps {
    --num: 2.75rem;
    --track-gap: 1.25rem;
    display: grid;
    gap: var(--track-gap);
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: var(--num) minmax(0, 1fr);
    column-gap: 1rem;
    /* Track colour runs from signal yellow to the muted rule, step by step. */
    --from: color-mix(in oklab, var(--rule) calc(var(--i) / var(--steps) * 100%), var(--signal));
    --to: color-mix(in oklab, var(--rule) calc((var(--i) + 1) / var(--steps) * 100%), var(--signal));
  }
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--num) / 2 - 1px);
    top: var(--num);
    bottom: calc(-1 * var(--track-gap));
    width: 2px;
    background: linear-gradient(var(--from), var(--to));
  }
  .step-num {
    display: grid;
    place-items: center;
    width: var(--num);
    height: var(--num);
    border: 2px solid var(--signal);
    border-radius: var(--radius-full);
    color: var(--signal);
    font-size: 1rem;
    font-stretch: 112%;
    font-weight: 700;
  }
  .step-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid color-mix(in oklab, var(--rule) 45%, transparent);
    border-radius: var(--radius-node);
    background: var(--panel);
  }
  .step-title {
    font-size: 1.375rem;
    line-height: 1.05;
    font-stretch: 118%;
    font-weight: 750;
    letter-spacing: -0.01em;
  }
  .step-body {
    color: color-mix(in oklab, var(--muted) 70%, var(--ink));
    font-size: 0.9375rem;
    line-height: 1.65;
  }
  /* What the client walks away with; pinned to the bottom so the chips line up. */
  .step-outcome {
    display: inline-flex;
    align-self: flex-start;
    gap: 0.375rem;
    margin-top: auto;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--signal) 15%, transparent);
    color: var(--signal);
    font-size: 0.78125rem;
    line-height: 1.25;
    font-weight: 650;
    white-space: nowrap;
  }
  .step-body:has(+ .step-outcome) {
    margin-bottom: 1.5rem; /* minimum gap; the chip's auto margin takes the rest */
  }

  @media (min-width: 48rem) {
    .process-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  /*
   * --- Steps: a snake on wide screens ---
   * Two rows of three: 1 → 2 → 3, then the track turns down the right side and
   * runs back 4 ← 5 ← 6. Only for exactly six steps; any other count keeps the
   * stacked layout above.
   */
  @media (min-width: 64rem) {
    .steps:has(> .step:nth-child(6):last-child) {
      --num: 3.375rem;
      --turn: 2.25rem; /* room on the right for the track's U-turn */
      grid-template-columns: repeat(3, minmax(0, 1fr));
      /* ring row, card row, ring row, card row */
      grid-template-rows: var(--num) auto var(--num) auto;
      gap: 1.25rem;
      padding-right: var(--turn);
    }
    .steps:has(> .step:nth-child(6):last-child) .step {
      grid-row: span 2;
      grid-template-columns: none;
      grid-template-rows: subgrid;
      row-gap: 1.25rem;
    }
    .steps:has(> .step:nth-child(6):last-child) .step::before {
      display: none;
    }
    .steps:has(> .step:nth-child(6):last-child) .step:nth-child(1) {
      grid-area: 1 / 1 / span 2;
    }
    .steps:has(> .step:nth-child(6):last-child) .step:nth-child(2) {
      grid-area: 1 / 2 / span 2;
    }
    .steps:has(> .step:nth-child(6):last-child) .step:nth-child(3) {
      grid-area: 1 / 3 / span 2;
    }
    .steps:has(> .step:nth-child(6):last-child) .step:nth-child(4) {
      grid-area: 3 / 3 / span 2;
    }
    .steps:has(> .step:nth-child(6):last-child) .step:nth-child(5) {
      grid-area: 3 / 2 / span 2;
    }
    .steps:has(> .step:nth-child(6):last-child) .step:nth-child(6) {
      grid-area: 3 / 1 / span 2;
    }
    /*
     * The whole track is one box: top edge through rings 1-3, rounded right
     * side, bottom edge back through rings 4-6. Only those three edges are
     * drawn (a gradient masked to the padding), yellow on top fading below.
     */
    .steps:has(> .step:nth-child(6):last-child)::before {
      content: '';
      grid-area: 1 / 1 / 4 / -1;
      margin: calc(var(--num) / 2 - 1px) calc(-1 * var(--turn)) calc(var(--num) / 2 - 1px)
        calc(var(--num) / 2);
      padding: 2px 2px 2px 0;
      border-radius: 0 var(--turn) var(--turn) 0;
      background: linear-gradient(var(--signal), color-mix(in oklab, var(--signal) 35%, var(--rule)));
      mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
      mask-clip: content-box, border-box;
      mask-composite: exclude;
      pointer-events: none;
    }
    /* Rings sit on the track; the fill hides the line behind them. */
    .steps:has(> .step:nth-child(6):last-child) .step-num {
      position: relative;
      background: var(--band);
      font-size: 1.0625rem;
    }
    .steps:has(> .step:nth-child(6):last-child) .step-card {
      padding: 1.5rem;
    }
  }
</style>
