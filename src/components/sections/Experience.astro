---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import fastLogo from '@/assets/logos/fast-nuces.png';
import Eyebrow from '@/components/Eyebrow.astro';
import T from '@/components/T.astro';
import { byOrder, formatMonth } from '@/lib/format';
import { hasTodo } from '@/lib/todo';

// order: 1 is the newest role.
const jobs = (await getCollection('experience')).sort(byOrder);
const education = (await getCollection('education')).sort(byOrder);

// Header stats, from the roles themselves.
const starts = jobs.map((j) => j.data.start).filter((d) => /^\d{4}-\d{2}$/.test(d)).sort();
const firstStart = starts[0] ? new Date(`${starts[0]}-01`) : null;
const years = firstStart
  ? Math.floor((Date.now() - firstStart.getTime()) / (365.25 * 24 * 3600 * 1000))
  : null;

/** "v4.0 · latest" … "v1.0 · first commit": newest role is the highest version. */
const version = (i: number) =>
  `v${jobs.length - i}.0` + (i === 0 ? ' · latest' : i === jobs.length - 1 ? ' · first commit' : '');

/** Split a highlight so percentages can be marked: "by 25%." → ["by ", "25%", "."]. */
const parts = (text: string) => text.split(/(\d+(?:\.\d+)?%)/);
---

<section id="experience" aria-labelledby="experience-title" class="shell section-gap">
  <div class="exp-head">
    <hgroup>
      <Eyebrow label="Career" />
      <h2 id="experience-title" class="type-section-display mt-3">Experience</h2>
    </hgroup>
    <dl class="exp-stats">
      {years !== null && (
        <div class="exp-stat">
          <dt>years building</dt>
          <dd>{years}+</dd>
        </div>
      )}
      <div class="exp-stat">
        <dt>roles</dt>
        <dd>{jobs.length}</dd>
      </div>
      <div class="exp-stat exp-stat--dark">
        <dt>the path</dt>
        <dd>.NET → Cloud</dd>
      </div>
    </dl>
  </div>

  <!--
    A version history: newest role on top. The label, the dot and the card's
    title share one top line, so they always sit level.
    While scrolling, a yellow dot runs down the rail, level with the middle of
    the screen, leaving a yellow trail; each role's dot lights up as it passes.
  -->
  <div class="timeline-wrap mt-12 md:mt-16" data-timeline>
    <span class="timeline-trail" aria-hidden="true"></span>
    <span class="timeline-runner" aria-hidden="true"></span>
    <ol role="list" class="timeline">
      {jobs.map((job, i) => (
        <li class:list={['stage', i === 0 && job.data.end === 'present' && 'stage--current']}>
          <p class="stage-label">
            <span class="stage-version">{version(i)}</span>
            <span class="stage-dates">
              <T v={formatMonth(job.data.start)} />
              <span aria-hidden="true"> – </span>
              <span class="sr-only"> to </span>
              <T v={formatMonth(job.data.end)} />
            </span>
          </p>
          <span class="stage-dot" aria-hidden="true"></span>
          <div class="stage-card">
            <div class="stage-title-row">
              <h3 class="stage-title">
                <T v={job.data.role} />
              </h3>
              {i === 0 && job.data.end === 'present' && (
                <span class="stage-badge">
                  <span class="stage-badge-dot" aria-hidden="true"></span>
                  Current role
                </span>
              )}
            </div>
            <p class="stage-company">
              <T v={job.data.company} />
              {job.data.location && (
                <>
                  , <T v={job.data.location} />
                </>
              )}
            </p>
            <ul role="list" class="stage-highlights mt-4">
              {job.data.highlights.map((h) => (
                <li>
                  {hasTodo(h) ? (
                    <T v={h} />
                  ) : (
                    parts(h).map((part, k) => (k % 2 === 1 ? <mark class="stage-num">{part}</mark> : part))
                  )}
                </li>
              ))}
            </ul>
            {job.data.stack.length > 0 && (
              <ul role="list" class="stage-stack mt-5" aria-label="Stack">
                {job.data.stack.map((t) => (
                  <li>
                    <T v={t} />
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="education mt-20 md:mt-24">
    <hgroup>
      <Eyebrow label="Background" />
      <h3 class="type-section-display mt-3">Education</h3>
    </hgroup>
    <ul role="list" class="edu-list mt-8">
      {education.map((e) => (
        <li class="edu-row">
          <p class="edu-year" aria-hidden="true">
            <T v={String(e.data.year)} />
          </p>
          <div class="edu-text">
            <p class="edu-degree">
              <T v={e.data.degree} />
            </p>
            <p class="edu-school mt-2">
              <T v={e.data.institution} />
              <span class="sr-only">, graduated {e.data.year}</span>
            </p>
          </div>
          <!-- Transparent copy of public/education.jpg (checkerboard removed), src/assets/logos/fast-nuces.png. -->
          <div class="edu-logo">
            <Image src={fastLogo} alt="FAST-NUCES" widths={[240, 480]} sizes="12rem" />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* --- Education: rules above and below, a giant outlined year, text, logo --- */
  .edu-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 2rem;
    align-items: center;
    padding-block: 1.75rem;
    border-top: 1.5px solid var(--ink);
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 60%, transparent);
  }
  .edu-year {
    /* Outlined like the footer name: double stroke under a page-coloured fill hides glyph seams. */
    color: var(--page);
    -webkit-text-stroke: 3px var(--ink);
    paint-order: stroke fill;
    font-size: clamp(4.5rem, 3rem + 7vw, 8.5rem);
    line-height: 0.85;
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .edu-degree {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1.1;
    font-stretch: 118%;
    font-weight: 800;
  }
  .edu-school {
    max-width: 30rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .edu-logo {
    width: min(12rem, 100%);
  }
  .edu-logo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (min-width: 48rem) {
    .edu-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 2.5rem;
    }
  }

  /* --- Header: heading left, stats right --- */
  .exp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }
  .exp-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .exp-stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: center;
    min-width: 4.5rem;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-node);
    background: light-dark(#fff, var(--panel));
  }
  .exp-stat dd {
    font-size: 1.375rem;
    line-height: 1.1;
    font-stretch: 118%;
    font-weight: 800;
  }
  .exp-stat dt {
    color: var(--muted);
    font-size: 0.6875rem;
  }
  .exp-stat--dark {
    color-scheme: dark;
    background: var(--band);
    color: var(--ink);
  }

  /*
   * --- Timeline ---
   * Columns: label | rail | card. Every row's label, dot and card title start at
   * the same line: the card's top padding (--pad), so they always sit level.
   */
  .timeline {
    --pad: 1.5rem;
    --title-lh: 1.75rem; /* one line of .stage-title */
    --dot: 0.875rem;
    --gap: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    grid-template-areas: 'rail label' 'rail card';
    column-gap: 0.75rem;
    row-gap: 0.5rem;
  }
  .stage-label {
    grid-area: label;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  .stage-version {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .stage-dates {
    font-size: 0.875rem;
    font-weight: 700;
  }
  .stage-dot {
    grid-area: rail;
    position: relative;
    z-index: 1;
    justify-self: center;
    width: var(--dot);
    height: var(--dot);
    margin-top: calc((1.25rem - var(--dot)) / 2); /* level with the label line */
    border: 2px solid var(--ink);
    border-radius: var(--radius-full);
    background: var(--page);
  }
  .stage--current .stage-dot {
    border-color: var(--on-signal);
    background: var(--signal);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--signal) 30%, transparent);
  }
  /* Roles the moving dot has reached. */
  .stage-dot {
    transition: background-color 0.3s ease;
  }
  .stage[data-reached] .stage-dot {
    background: var(--signal);
  }

  /*
   * --- Scroll runner ---
   * The script measures the rail (--x) and the first dot (--y0), and moves the
   * runner by --y as the page scrolls. Hidden until measured (data-live).
   */
  .timeline-wrap {
    position: relative;
  }
  .timeline-trail,
  .timeline-runner {
    position: absolute;
    top: var(--y0, 0);
    left: var(--x, 0);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .timeline-wrap[data-live] :is(.timeline-trail, .timeline-runner) {
    opacity: 1;
  }
  /* Over the grey rail, under the role dots. */
  .timeline-trail {
    z-index: 1;
    width: 2px;
    height: var(--y, 0);
    translate: -50% 0;
    border-radius: 1px;
    background: var(--signal);
  }
  .timeline-runner {
    z-index: 2;
    width: 1.125rem;
    height: 1.125rem;
    translate: -50% calc(var(--y, 0px) - 50%);
    border: 2px solid var(--on-signal);
    border-radius: var(--radius-full);
    background: var(--signal);
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--signal) 30%, transparent);
  }
  /* A soft ping, so it reads as live. */
  .timeline-runner::after {
    content: '';
    position: absolute;
    inset: -2px;
    border: 2px solid var(--signal);
    border-radius: inherit;
    animation: runner-ping 2s var(--ease-out) infinite;
  }
  @keyframes runner-ping {
    from {
      opacity: 0.55;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 2.6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-runner::after {
      animation: none;
      opacity: 0;
    }
  }
  /* The rail: from this dot down to the next one. */
  .stage:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(0.75rem - 1px);
    top: 0.625rem;
    bottom: calc(-1 * var(--gap) - 0.625rem);
    width: 2px;
    background: color-mix(in oklab, var(--rule) 80%, transparent);
  }

  .stage-card {
    grid-area: card;
    padding: var(--pad);
    border-radius: 1rem;
    background: light-dark(#fff, var(--panel));
    box-shadow: 0 14px 30px -24px rgb(15 42 46 / 0.4);
  }
  .stage--current .stage-card {
    color-scheme: dark;
    background: var(--band);
    color: var(--ink);
  }
  .stage-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .stage-title {
    font-size: 1.375rem;
    line-height: var(--title-lh);
    font-stretch: 118%;
    font-weight: 780;
  }
  .stage-company {
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .stage--current .stage-company {
    color: var(--signal);
  }
  .stage-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid color-mix(in oklab, #3ecf8e 45%, transparent);
    border-radius: var(--radius-full);
    color: #7fe0b4;
    font-size: 0.75rem;
    font-weight: 650;
  }
  .stage-badge-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: #3ecf8e;
  }
  .stage-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .stage-highlights li {
    position: relative;
    padding-left: 1.125rem;
    color: color-mix(in oklab, var(--muted) 45%, var(--ink));
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .stage-highlights li::before {
    content: '';
    position: absolute;
    left: 0.125rem;
    top: 0.6em;
    width: 0.4rem;
    height: 0.4rem;
    rotate: 45deg;
    background: var(--accent);
  }
  .stage--current .stage-highlights li::before {
    background: var(--signal);
  }
  .stage-num {
    padding: 0.05em 0.3em;
    border-radius: 0.3em;
    background: var(--signal);
    color: var(--on-signal);
    font-weight: 700;
  }
  .stage-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .stage-stack li {
    padding: 0.25rem 0.55rem;
    border: 1px solid color-mix(in oklab, var(--rule) 70%, transparent);
    border-radius: 0.375rem;
    background: color-mix(in oklab, var(--panel) 70%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* Wide: label column on the left, aligned with the card's title line. */
  @media (min-width: 48rem) {
    .stage {
      grid-template-columns: 9.5rem 1.5rem minmax(0, 1fr);
      grid-template-areas: 'label rail card';
      column-gap: 1.25rem;
    }
    .stage-label {
      flex-direction: column;
      gap: 0.25rem;
      padding-top: var(--pad);
    }
    .stage-dot {
      /* centred on the card's first title line */
      margin-top: calc(var(--pad) + (var(--title-lh) - var(--dot)) / 2);
    }
    .stage:not(:last-child)::before {
      left: calc(9.5rem + 1.25rem + 0.75rem - 1px);
      top: calc(var(--pad) + var(--title-lh) / 2);
      bottom: calc(-1 * var(--gap) - var(--pad) - var(--title-lh) / 2);
    }
  }
</style>

<script>
  // The yellow runner: follows the middle of the screen down the rail,
  // clamped between the first and the last role's dot.
  function initTimeline() {
    const wrap = document.querySelector<HTMLElement>('[data-timeline]');
    if (!wrap) return;
    const stages = [...wrap.querySelectorAll<HTMLElement>('.stage')];
    const dots = stages.map((s) => s.querySelector<HTMLElement>('.stage-dot'));
    if (stages.length < 2 || dots.some((d) => !d)) return;

    // Window listeners outlive this page's DOM under the client router.
    const lifetime = new AbortController();
    const { signal } = lifetime;
    document.addEventListener('astro:before-swap', () => lifetime.abort(), { once: true });

    let ys: number[] = []; // dot centres, from the top of the wrapper
    let frame = 0;

    const update = () => {
      frame = 0;
      const top = wrap.getBoundingClientRect().top;
      const line = window.innerHeight / 2 - top;
      const y = Math.min(ys[ys.length - 1], Math.max(ys[0], line));
      wrap.style.setProperty('--y', `${y - ys[0]}px`);
      stages.forEach((s, i) => s.toggleAttribute('data-reached', y >= ys[i] - 1));
    };

    const measure = () => {
      const box = wrap.getBoundingClientRect();
      const rects = dots.map((d) => d!.getBoundingClientRect());
      ys = rects.map((r) => r.top + r.height / 2 - box.top);
      wrap.style.setProperty('--x', `${rects[0].left + rects[0].width / 2 - box.left}px`);
      wrap.style.setProperty('--y0', `${ys[0]}px`);
      update();
    };

    measure();
    wrap.dataset.live = '';
    window.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true, signal },
    );
    window.addEventListener('resize', measure, { signal });
    // Fonts arriving or cards reflowing move the dots.
    const sizes = new ResizeObserver(() => measure());
    sizes.observe(wrap);
    signal.addEventListener('abort', () => sizes.disconnect());
  }
  document.addEventListener('astro:page-load', initTimeline);
</script>
