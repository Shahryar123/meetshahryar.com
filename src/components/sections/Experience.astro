---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import fastLogo from '@/assets/logos/fast-nuces.png';
import Section from '@/components/Section.astro';
import T from '@/components/T.astro';
import { byOrder, formatMonth } from '@/lib/format';

// order: 1 is the newest role.
const jobs = (await getCollection('experience')).sort(byOrder);
const education = (await getCollection('education')).sort(byOrder);
---

<Section id="experience" title="Experience">
  <!--
    Stages of a deploy pipeline. Each stage chip is the hero's node shape and
    holds the dates. Phase 3 draws the line on scroll and lights each chip as
    it reaches the middle of the viewport; this is the final state.
  -->
  <ol role="list" class="timeline">
    {jobs.map((job) => (
      <li class="stage">
        <div class="rail">
          <p class="stage-chip type-control tabular-nums">
            <T v={formatMonth(job.data.start)} />
            <span aria-hidden="true">–</span>
            <span class="sr-only">to</span>
            <T v={formatMonth(job.data.end)} />
          </p>
          <span class="rail-line" aria-hidden="true" />
        </div>
        <div class="stage-body">
          <h3 class="type-subhead">
            <T v={job.data.role} />
          </h3>
          <p class="text-muted">
            <T v={job.data.company} />{job.data.location && <>, <T v={job.data.location} /></>}
          </p>
          <ul role="list" class="highlights measure mt-4 space-y-2">
            {job.data.highlights.map((h) => (
              <li>
                <T v={h} />
              </li>
            ))}
          </ul>
          {job.data.stack.length > 0 && (
            <p class="mt-4 type-small text-muted">
              <T v={job.data.stack.join(', ')} />
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>

  <div class="education mt-20 md:mt-24">
    <div>
      <!-- Same size as the section headings (e.g. Certifications). -->
      <h3 class="type-h2">Education</h3>
      <ul role="list" class="mt-6 space-y-4 md:mt-8">
        {education.map((e) => (
          <li>
            <p class="font-[560]">
              <T v={e.data.degree} />
            </p>
            <p class="text-muted">
              <T v={e.data.institution} />, <T v={e.data.year} />
            </p>
          </li>
        ))}
      </ul>
    </div>
    <!-- Cropped, transparent copy of public/education.png. -->
    <div class="edu-logo">
      <Image src={fastLogo} alt="FAST-NUCES" widths={[224, 448]} sizes="14rem" />
    </div>
  </div>
</Section>

<style>
  /* Text left, logo right; the logo drops below the text on narrow screens. */
  .education {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .edu-logo {
    width: min(14rem, 100%);
  }
  .edu-logo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .timeline {
    --stage-gap: 3.5rem;
    --chip-mid: 1.375rem; /* half the 2.75rem chip */
    display: flex;
    flex-direction: column;
    gap: var(--stage-gap);
  }

  /* Mobile: the track runs down the left edge, each chip above its role. */
  .stage {
    position: relative;
    padding-left: 1.75rem;
  }
  .stage:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 0.375rem;
    top: var(--chip-mid);
    bottom: calc(-1 * var(--stage-gap) - var(--chip-mid));
    width: 1.5px;
    background: var(--muted);
  }
  .stage-chip {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-node);
    background: var(--panel);
  }
  .stage-chip::before {
    content: '';
    position: absolute;
    top: calc(var(--chip-mid) - 0.75px);
    right: 100%;
    width: calc(1.75rem - 0.375rem);
    height: 1.5px;
    background: var(--rule);
  }
  .rail-line {
    display: none;
  }
  .stage-body {
    margin-top: 1rem;
  }
  .highlights li {
    position: relative;
    padding-left: 1.125rem;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 1.5px;
    background: var(--muted);
  }

  /* Desktop: chip column on the left, a line from each chip to the next. */
  @media (min-width: 48rem) {
    .stage {
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: 2rem;
      padding-left: 0;
    }
    .stage:not(:last-child)::before {
      display: none;
    }
    .rail {
      display: flex;
      flex-direction: column;
    }
    .stage-chip {
      justify-content: center;
      text-align: center;
    }
    .stage-chip::before {
      right: auto;
      left: 100%;
      top: calc(50% - 0.75px);
      width: 1.25rem; /* stops short of the role title */
    }
    .rail-line {
      display: block;
      flex: 1;
      align-self: center;
      width: 1.5px;
      margin-bottom: calc(-1 * var(--stage-gap));
      background: var(--muted);
    }
    .stage:last-child .rail-line {
      display: none;
    }
    .stage-body {
      margin-top: 0.5rem;
    }
  }
</style>
