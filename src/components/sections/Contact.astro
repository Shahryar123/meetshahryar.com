---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import MousePointer from '@lucide/astro/icons/mouse-pointer-2';
import SendIcon from '@lucide/astro/icons/send';
import CalendarIcon from '@lucide/astro/icons/calendar';
import CheckIcon from '@lucide/astro/icons/check';
import CopyIcon from '@lucide/astro/icons/copy';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import CircleAlert from '@lucide/astro/icons/circle-exclamation-point';
import MailIcon from '@lucide/astro/icons/mail';
import T from '@/components/T.astro';
import { getSite } from '@/lib/site';
import { CATEGORIES } from '@/lib/categories';
import { hasTodo, isEmail, isHttpUrl } from '@/lib/todo';

const site = await getSite();
const email = isEmail(site.email) ? site.email : '';
const calendly = isHttpUrl(site.links.calendly) ? site.links.calendly : '';
const projectTypes = [
  ...CATEGORIES.map((c) => c.label),
  'A full-time or contract role',
  'Something else',
];
const budgets = site.contact.budgets.filter((b) => !hasTodo(b));

const errorFor = (field: string) => `${field}-error`;
---

<!--
  A signal-yellow panel: the invitation and direct links on the left, the form
  on an always-dark card on the right.
-->
<section id="contact" aria-labelledby="contact-title" class="shell section-gap">
  <div class="contact-panel">
    <span class="contact-ring" aria-hidden="true"></span>
    <div class="contact-intro">
      <div class="contact-head">
        <hgroup>
          <p class="contact-eyebrow">Get in touch</p>
          <h2 id="contact-title" class="contact-title mt-4">
            <span class="block">Let's</span> <span class="block">talk.</span>
          </h2>
        </hgroup>

        <!--
          Decoration: an isometric server stack whose layers float, LEDs blink and
          a cursor orbits it. Everything stops for prefers-reduced-motion.
        -->
        <div class="rack-wrap" aria-hidden="true">
          <div class="rack">
            <p class="rack-badge"><span class="rack-badge-dot"></span>reply &lt; 1 working day</p>
            <svg class="rack-svg" viewBox="0 0 220 200" width="220" height="200">
              <ellipse class="rack-shadow" cx="110" cy="182" rx="46" ry="8"></ellipse>
              <ellipse class="rack-orbit" cx="110" cy="128" rx="100" ry="34"></ellipse>
              {[94, 62, 30].map((y, i) => (
                <g class={`slab slab-${i}`}>
                  <path class="slab-left" d={`M50 ${y + 30} L110 ${y + 60} L110 ${y + 84} L50 ${y + 54} Z`}></path>
                  <path class="slab-right" d={`M110 ${y + 60} L170 ${y + 30} L170 ${y + 54} L110 ${y + 84} Z`}></path>
                  <path class="slab-top" d={`M110 ${y} L170 ${y + 30} L110 ${y + 60} L50 ${y + 30} Z`}></path>
                  <circle class={`led led-${i}`} cx="62" cy={y + 44} r="2.6"></circle>
                  <line class="vent" x1="124" y1={y + 64} x2="158" y2={y + 47}></line>
                  <line class="vent" x1="124" y1={y + 70} x2="158" y2={y + 53}></line>
                  {i === 2 && <path class="slab-chip" d={`M110 ${y + 20} L124 ${y + 27} L110 ${y + 34} L96 ${y + 27} Z`}></path>}
                </g>
              ))}
            </svg>
            <span class="rack-cursor">
              <MousePointer size={18} stroke-width={1.75} />
            </span>
          </div>
        </div>
      </div>

      <p class="contact-text mt-6">
        <T v={site.contact.invitation} />
      </p>

      <ul role="list" class="mt-8 space-y-3">
        <li class="contact-card-row">
          <span class="contact-icon" aria-hidden="true">
            <MailIcon size={17} stroke-width={2} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="contact-row-label">Email</p>
            {email ? (
              <a class="contact-row-value [overflow-wrap:anywhere]" href={`mailto:${email}`}>
                {email}
              </a>
            ) : (
              <T v={site.email} />
            )}
          </div>
          {email && (
            <button
              type="button"
              class="contact-copy"
              data-copy-email={email}
              aria-label="Copy email address"
              title="Copy email address"
            >
              <CopyIcon size={18} stroke-width={2} aria-hidden="true" class="copy-idle" />
              <CheckIcon size={18} stroke-width={2.25} aria-hidden="true" class="copy-done" />
            </button>
          )}
        </li>
        <li>
          {calendly ? (
            <a class="contact-card-row" href={calendly}>
              <span class="contact-icon" aria-hidden="true">
                <CalendarIcon size={17} stroke-width={2} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="contact-row-label">Prefer to talk?</p>
                <p class="contact-row-value">Book a 20-minute call</p>
              </div>
              <ArrowRight size={20} stroke-width={2} aria-hidden="true" class="contact-go" />
            </a>
          ) : (
            <div class="contact-card-row">
              <span class="contact-icon" aria-hidden="true">
                <CalendarIcon size={17} stroke-width={2} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="contact-row-label">Prefer to talk?</p>
                <p class="contact-row-value">
                  Book a 20-minute call <span class="todo">[Calendly URL]</span>
                </p>
              </div>
            </div>
          )}
        </li>
      </ul>
      <p class="sr-only" role="status" data-copy-status></p>
    </div>

    <div class="contact-card">
      <div class="form-head">
        <h3 class="form-title">Start a project</h3>
        <span class="form-path" aria-hidden="true">~/new-project</span>
      </div>
    <form
      class="contact-form"
      method="post"
      novalidate
      data-contact-form
      data-endpoint=""
      data-email={email}
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="field">
          <label for="cf-name">Name</label>
          <input
            id="cf-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            aria-describedby={errorFor('cf-name')}
            data-error="Enter your name."
          />
          <p class="field-error" id={errorFor('cf-name')} hidden></p>
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input
            id="cf-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby={errorFor('cf-email')}
            data-error="Enter an email address, like name@example.com."
          />
          <p class="field-error" id={errorFor('cf-email')} hidden></p>
        </div>
        <div class="field">
          <label for="cf-type">Project type</label>
          <div class="select">
            <select
              id="cf-type"
              name="projectType"
              required
              aria-describedby={errorFor('cf-type')}
              data-error="Choose the kind of work you have in mind."
            >
              <option value="">Choose one</option>
              {projectTypes.map((t) => (
                <option>{t}</option>
              ))}
            </select>
            <ChevronDown size={18} stroke-width={1.75} aria-hidden="true" class="select-icon" />
          </div>
          <p class="field-error" id={errorFor('cf-type')} hidden></p>
        </div>
        <div class="field">
          <label for="cf-budget">Budget <span class="optional">(optional)</span></label>
          <div class="select">
            <select id="cf-budget" name="budget">
              <option value="">Choose a range</option>
              {budgets.map((b) => (
                <option>{b}</option>
              ))}
              <option>Not sure yet</option>
            </select>
            <ChevronDown size={18} stroke-width={1.75} aria-hidden="true" class="select-icon" />
          </div>
          {budgets.length === 0 && (
            <p class="mt-2 type-small">
              <span class="todo">[budget ranges in your currency]</span>
            </p>
          )}
        </div>
        <div class="field sm:col-span-2">
          <label for="cf-message">Message</label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            required
            minlength="20"
            placeholder="What are you running, and what's getting in the way?"
            aria-describedby={errorFor('cf-message')}
            data-error="Tell me a little about the project: at least 20 characters."
          ></textarea>
          <p class="field-error" id={errorFor('cf-message')} hidden></p>
        </div>
      </div>

      <!-- Honeypot: people never see or fill this; bots often do. -->
      <div class="hp" aria-hidden="true">
        <label for="cf-website">Leave this field empty</label>
        <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="btn btn-primary send mt-6">
        Send message
        <SendIcon size={17} stroke-width={2} aria-hidden="true" />
      </button>
      <p class="mt-3 type-small" role="status" data-form-status></p>
      <template id="cf-alert-icon">
        <CircleAlert size={18} stroke-width={1.75} aria-hidden="true" class="mt-0.5 flex-none" />
      </template>
    </form>
    </div>
  </div>
</section>

<style>
  /* --- Yellow panel --- */
  .contact-panel {
    position: relative;
    display: grid;
    gap: 2.5rem;
    overflow: hidden;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    border-radius: 1.5rem;
    background: var(--signal);
    color: var(--on-signal);
  }
  /* A large dotted ring, cut off by the panel's bottom-left corner. */
  .contact-ring {
    position: absolute;
    bottom: -12rem;
    left: -10rem;
    width: 24rem;
    height: 24rem;
    border: 2px dotted color-mix(in oklab, var(--on-signal) 22%, transparent);
    border-radius: var(--radius-full);
    pointer-events: none;
  }
  .contact-intro,
  .contact-card {
    position: relative;
  }
  .contact-eyebrow {
    font-size: 0.75rem;
    line-height: 1.2;
    font-stretch: 112%;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .contact-title {
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    line-height: 0.92;
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .contact-text {
    max-width: 30rem;
    color: color-mix(in oklab, var(--on-signal) 85%, var(--signal));
    line-height: 1.65;
  }
  /* --- Heading with the server graphic beside it --- */
  .contact-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  /* The graphic is drawn at 220×200 and scaled to fit; the wrapper reserves the scaled size. */
  .rack-wrap {
    --s: 0.6;
    flex: none;
    width: calc(220px * var(--s));
    height: calc(230px * var(--s));
  }
  @media (min-width: 30rem) {
    .rack-wrap {
      --s: 0.8;
    }
  }
  @media (min-width: 80rem) {
    .rack-wrap {
      --s: 0.95;
    }
  }
  .rack {
    position: relative;
    width: 220px;
    height: 230px;
    scale: var(--s);
    transform-origin: top left;
  }
  .rack-svg {
    position: absolute;
    left: 0;
    top: 30px;
    overflow: visible;
  }
  .rack-badge {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--on-signal);
    color: #e6efec;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
    box-shadow: 0 8px 18px -10px rgb(15 42 46 / 0.6);
  }
  .rack-badge-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: #3ecf8e;
    animation: pulse 2s ease-in-out infinite;
  }
  .rack-shadow {
    fill: color-mix(in oklab, var(--on-signal) 85%, transparent);
  }
  .rack-orbit {
    fill: none;
    stroke: color-mix(in oklab, var(--on-signal) 45%, transparent);
    stroke-width: 1.25;
    stroke-dasharray: 4 5;
  }
  .slab-top {
    fill: #2f5c62;
  }
  .slab-left {
    fill: #1d3e43;
  }
  .slab-right {
    fill: #15363b;
  }
  .slab-chip {
    fill: var(--signal);
  }
  .vent {
    stroke: #3f6d73;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .led {
    fill: #3ecf8e;
  }
  /* Layers bob out of step; LEDs blink at different rates. */
  .slab {
    animation: bob 3.2s ease-in-out infinite;
  }
  .slab-1 {
    animation-delay: -1.1s;
  }
  .slab-2 {
    animation-delay: -2.2s;
  }
  .led-0 {
    animation: blink 1.6s steps(1) infinite;
  }
  .led-1 {
    animation: blink 2.3s steps(1) infinite -0.7s;
  }
  .led-2 {
    animation: blink 1.9s steps(1) infinite -1.3s;
  }
  /* The cursor travels the dashed orbit (same ellipse, in the rack's pixel space). */
  .rack-cursor {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    color: var(--on-signal);
    offset-path: path('M10 158 A100 34 0 1 0 210 158 A100 34 0 1 0 10 158');
    /* Turn with the path; the icon's tip points up-left (-135deg), so add 135deg to face forward. */
    offset-rotate: auto 135deg;
    offset-anchor: 9px 9px;
    animation: orbit 9s linear infinite;
  }
  @keyframes bob {
    50% {
      translate: 0 -4px;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  @keyframes orbit {
    to {
      offset-distance: 100%;
    }
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slab,
    .led-0,
    .led-1,
    .led-2,
    .rack-badge-dot,
    .rack-cursor {
      animation: none;
    }
  }

  /* --- Email and call cards --- */
  .contact-card-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1.125rem 0.875rem 0.875rem;
    border-radius: var(--radius-node);
    background: color-mix(in oklab, var(--signal) 55%, white);
    color: var(--on-signal);
  }
  a.contact-card-row {
    transition: background-color 0.2s ease;
  }
  a.contact-card-row:hover {
    background: color-mix(in oklab, var(--signal) 40%, white);
  }
  .contact-card-row .contact-icon {
    border-radius: 0.625rem;
    width: 2.5rem;
    height: 2.5rem;
  }
  .contact-row-label {
    font-size: 0.6875rem;
    line-height: 1.3;
    font-stretch: 112%;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .contact-row-value {
    display: block;
    font-weight: 700;
    line-height: 1.35;
  }
  a.contact-row-value:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* Icon button: copy icon, swapped for a check for 2s after copying. */
  .contact-copy {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.625rem;
    color: var(--on-signal);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .contact-copy:hover {
    background: color-mix(in oklab, var(--on-signal) 10%, transparent);
  }
  .contact-copy :global(.copy-done),
  .contact-copy[data-copied] :global(.copy-idle) {
    display: none;
  }
  .contact-copy[data-copied] :global(.copy-done) {
    display: block;
  }
  .contact-card-row :global(.contact-go) {
    flex: none;
    transition: translate 0.2s var(--ease-out);
  }
  a.contact-card-row:hover :global(.contact-go) {
    translate: 0.25rem 0;
  }

  /* --- Form header --- */
  .form-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 70%, transparent);
  }
  .form-title {
    font-size: 1.25rem;
    font-stretch: 112%;
    font-weight: 750;
  }
  .form-path {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .field textarea::placeholder {
    color: color-mix(in oklab, var(--muted) 80%, transparent);
  }

  .contact-row {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-weight: 650;
  }
  a.contact-row:hover > span:last-child {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background: var(--on-signal);
    color: var(--signal);
  }

  /* --- Form card: always dark --- */
  .contact-card {
    color-scheme: dark; /* tokens inside resolve to their dark values */
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: 1.125rem;
    background: var(--band);
    color: var(--ink);
    box-shadow: 0 30px 60px -30px rgb(15 42 46 / 0.6);
    transition: rotate 0.5s var(--ease-out);
  }
  /* A slight tilt on wide screens; it straightens while someone fills it in. */
  @media (min-width: 64rem) {
    .contact-card {
      rotate: 1.5deg;
    }
    .contact-card:focus-within,
    .contact-card:hover {
      rotate: 0deg;
    }
  }
  @media (min-width: 64rem) {
    .contact-panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 3.5rem;
      align-items: center;
    }
  }

  .field label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 650;
  }
  .optional {
    color: var(--muted);
    font-weight: 450;
  }
  .field input,
  .field select,
  .field textarea {
    display: block;
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in oklab, var(--rule) 80%, transparent);
    border-radius: var(--radius-chip);
    background: var(--panel);
    color: var(--ink);
    font: inherit;
  }
  .field textarea {
    resize: vertical;
  }
  .field select {
    appearance: none;
    padding-right: 2.75rem;
    cursor: pointer;
  }
  .field select option {
    background: var(--panel);
    color: var(--ink);
  }
  .select {
    position: relative;
  }
  .select :global(.select-icon) {
    position: absolute;
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--muted);
    pointer-events: none;
  }
  /* Errors never rely on colour: a heavier border, an icon and a sentence. */
  .field [aria-invalid='true'] {
    border-width: 2px;
    border-color: var(--ink);
  }
  .field-error {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }
  .send {
    width: 100%;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  /*
   * Phase 2: validation, the honeypot and clear status messages.
   * The form backend (Web3Forms or Lambda + SES) is wired in phase 6 by
   * setting data-endpoint; until then the form says it isn't connected.
   */
  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  function showError(field: Field, message: string | null) {
    const error = document.getElementById(`${field.id}-error`);
    if (!error) return;
    if (message) {
      field.setAttribute('aria-invalid', 'true');
      const icon = document.getElementById('cf-alert-icon');
      const text = document.createElement('span');
      text.textContent = message;
      error.replaceChildren(
        ...(icon instanceof HTMLTemplateElement ? [icon.content.cloneNode(true)] : []),
        text,
      );
      error.hidden = false;
    } else {
      field.removeAttribute('aria-invalid');
      error.hidden = true;
      error.textContent = '';
    }
  }

  function validate(field: Field): boolean {
    const ok = field.checkValidity();
    showError(field, ok ? null : (field.dataset.error ?? 'Check this field.'));
    return ok;
  }

  function initForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const fields = Array.from(form.querySelectorAll<Field>('[required]'));
    const email = form.dataset.email || '';

    // Errors appear on submit and clear while the visitor types the fix. Not on
    // blur: blur fires on mousedown, and removing an error there moves the Send
    // button out from under the pointer, so the click is lost.
    fields.forEach((f) =>
      f.addEventListener('input', () => {
        if (f.getAttribute('aria-invalid') === 'true') validate(f);
      }),
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (status) status.textContent = '';

      const invalid = fields.filter((f) => !validate(f));
      if (invalid.length) {
        invalid[0].focus();
        if (status)
          status.textContent =
            invalid.length === 1
              ? 'One field needs attention before this can send.'
              : `${invalid.length} fields need attention before this can send.`;
        return;
      }

      const data = new FormData(form);
      // A filled honeypot means a bot: pretend it worked and send nothing.
      if (data.get('website')) {
        form.reset();
        if (status) status.textContent = 'Thanks, your message has been sent.';
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        if (status)
          status.textContent =
            'This form isn’t connected yet [TODO: form backend, phase 6]. Please use the email address on this page instead.';
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      button?.setAttribute('disabled', '');
      if (status) status.textContent = 'Sending…';
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(data)),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        if (status)
          status.textContent = `Thanks, your message has been sent. I’ll reply to ${String(data.get('email'))}.`;
      } catch {
        if (status)
          status.textContent = email
            ? `Your message didn’t send. Check your connection and try again, or email me at ${email}.`
            : 'Your message didn’t send. Check your connection and try again.';
      } finally {
        button?.removeAttribute('disabled');
      }
    });
  }

  function initCopy() {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    const email = button?.dataset.copyEmail;
    if (!button || !email) return;
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        button.toggleAttribute('data-copied', true);
        button.setAttribute('aria-label', 'Email address copied');
        if (status) status.textContent = 'Email address copied.';
        clearTimeout(timer);
        timer = setTimeout(() => {
          button.removeAttribute('data-copied');
          button.setAttribute('aria-label', 'Copy email address');
        }, 2000);
      } catch {
        if (status) status.textContent = `Couldn't copy. The address is ${email}.`;
      }
    });
  }

  document.addEventListener('astro:page-load', () => {
    initForm();
    initCopy();
  });
</script>
