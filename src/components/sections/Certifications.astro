---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Section from '@/components/Section.astro';
import T from '@/components/T.astro';
import { byOrder, formatMonth } from '@/lib/format';
import { isHttpUrl } from '@/lib/todo';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';

const hasVerifyUrl = (c: { data: { verifyUrl: string } }) => isHttpUrl(c.data.verifyUrl);
// Certificates with a verify link first, then the rest; each group keeps its `order`.
const certs = (await getCollection('certifications'))
  .sort(byOrder)
  .sort((a, b) => Number(hasVerifyUrl(b)) - Number(hasVerifyUrl(a)));

type Cert = (typeof certs)[number];
/** Where Verify points: the issuer's verify page, or the full certificate scan when there's no link yet. */
const verifyHref = (c: Cert) =>
  hasVerifyUrl(c) ? c.data.verifyUrl : c.data.certificate?.src;
/** The site a certificate came from: `platform` when set (e.g. Coursera), else the issuer. */
const platformOf = (c: Cert) => c.data.platform ?? c.data.issuer;
const countFor = (platform: string) => certs.filter((c) => platformOf(c) === platform).length;

/** Two-letter tile text. Names that would clash or read badly get a fixed one. */
const MONOGRAMS: Record<string, string> = {
  Databricks: 'Db',
  DataCamp: 'DC',
  freeCodeCamp: 'fC',
  '10Pearls University': '10',
};
const monogram = (platform: string) => MONOGRAMS[platform] ?? platform.slice(0, 2);
---

{certs.length > 0 && (
  <Section id="certifications" eyebrow="Always learning" title="Certifications">
    {/* Phase 3 turns each tile into a flip card: badge on the front, details on the back. */}
    <ul role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {certs.map((c) => (
        <li class="cert">
          {c.data.certificate ? (
            <a class="cert-scan" href={c.data.certificate.src} target="_blank" rel="noopener">
              <Image
                src={c.data.certificate}
                alt={`${c.data.name} certificate (opens full size)`}
                widths={[400, 800]}
                sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 45vw, 92vw"
                class="size-full object-contain"
              />
            </a>
          ) : c.data.badge ? (
            /* No certificate scan: the badge sits in the same frame so cards line up. */
            <div class="cert-scan cert-scan--badge">
              <Image
                src={c.data.badge}
                alt={`${c.data.name} badge`}
                widths={[200, 400]}
                sizes="12rem"
                class="size-full object-contain"
              />
            </div>
          ) : (
            <div class="cert-badge">
              <span class="todo type-small">[badge]</span>
            </div>
          )}
          {/* The site it came from: monogram tile, name, and how many credentials it issued. */}
          <div class="platform mt-5">
            <span class="platform-tile" aria-hidden="true">
              {monogram(platformOf(c))}
            </span>
            <div class="min-w-0 flex-1">
              <p class="type-subhead">{platformOf(c)}</p>
              <p class="type-small text-muted">
                {countFor(platformOf(c))} {countFor(platformOf(c)) === 1 ? 'credential' : 'credentials'}
              </p>
            </div>
            <p class="issued tabular-nums">
              <T v={formatMonth(c.data.issueDate)} />
            </p>
          </div>

          <div class="credential mt-4 pt-4">
            <div class="min-w-0">
              <h3 class="font-[620]">
                <T v={c.data.name} />
              </h3>
              {(c.data.issuer !== platformOf(c) ||
                (c.data.expiryDate && c.data.expiryDate !== 'none')) && (
                <p class="type-small text-muted mt-1">
                  {c.data.issuer !== platformOf(c) && <>By {c.data.issuer}</>}
                  {c.data.expiryDate && c.data.expiryDate !== 'none' && (
                    <>
                      {' '}
                      Expires <T v={formatMonth(c.data.expiryDate)} />
                    </>
                  )}
                </p>
              )}
            </div>
            {verifyHref(c) && (
              <a class="verify btn btn-secondary" href={verifyHref(c)} target="_blank" rel="noopener">
                Verify<span class="sr-only"> {c.data.name} (opens in a new tab)</span>
                <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </Section>
)}

<style>
  .cert {
    padding: 1.5rem;
    border-radius: var(--radius-node);
    background: var(--panel);
  }
  .cert-badge {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
  }
  /* Certificates vary in shape; contain keeps the whole page visible. */
  .cert-scan {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: calc(var(--radius-node) * 0.6);
    background: var(--page);
    transition: transform 0.2s ease;
  }
  a.cert-scan:hover {
    transform: translateY(-2px);
  }
  .cert-scan--badge {
    padding: 1rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .cert-scan {
      transition: none;
    }
  }
  .platform {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  /* Same petrol and signal yellow in both themes; the outline separates it from dark panels. */
  .platform-tile {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-node);
    background: var(--on-signal);
    box-shadow: inset 0 0 0 1px var(--rule);
    color: var(--signal);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .credential {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid color-mix(in oklab, var(--rule) 45%, transparent);
  }
  /* Compact outline button: stands out from body text without nine yellow buttons. */
  .verify {
    flex: none;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    font-size: 0.875rem;
  }
  .issued {
    flex: none;
    font-weight: 680;
    white-space: nowrap;
  }
</style>
