---
/**
 * Clients: a grid of cards (logo, sector, name, what I did, tags), closed by a
 * dark "your product could be here" card that links to Contact.
 * Edit `clients` below. Logos keep their own colours; `darkLogo: true` puts a
 * logo with light lettering (Martin Sports) on a dark plate so it stays legible.
 * Text in "[brackets]" is a TODO: it shows with the dashed outline until filled in.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Eyebrow from '@/components/Eyebrow.astro';
import T from '@/components/T.astro';
import ideasRegistration from '@/assets/clients/ideasregistration.png';
import ideali from '@/assets/clients/ideali.png';
import britishInstruments from '@/assets/clients/britishinstruments.png';
import iqTech from '@/assets/clients/iqtechsol.png';
import martinSports from '@/assets/clients/martinsportsgear.png';

interface Client {
  name: string;
  sector: string;
  did: string;
  tags: string[];
  logo: ImageMetadata;
  darkLogo?: boolean;
}

const clients: Client[] = [
  {
    name: 'Ideali',
    logo: ideali,
    sector: 'SaaS platform',
    did: 'Cloud infrastructure, security hardening and CI/CD pipelines for the ideali.io platform.',
    tags: ['AWS', 'CI/CD', 'Security'],
  },
  {
    name: 'British Instruments',
    logo: britishInstruments,
    sector: 'Industrial instrumentation · UK',
    did: 'Website, SEO and content for a UK supplier of industrial measurement and control equipment.',
    tags: ['SEO', 'Content', 'Email campaigns'],
  },
  {
    name: 'IQ Tech Solutions',
    logo: iqTech,
    sector: 'Software services company',
    did: 'DevOps and cloud infrastructure, Azure Key Vault secrets security and automated email campaigns.',
    tags: ['DevOps', 'Cloud', 'Security', 'Automation'],
  },
  {
    name: 'Martin Sports',
    logo: martinSports,
    darkLogo: true,
    sector: 'Cricket equipment',
    did: 'Storefront design and UI for a cricket equipment brand.',
    tags: ['UI design', 'Web'],
  },
  {
    name: 'Ideas Registration',
    logo: ideasRegistration,
    sector: 'Registration services',
    did: 'Production build on AWS and migration off a GoDaddy VPS, with separate staging and testing databases.',
    tags: ['AWS', 'Migration', 'Databases'],
  },
];

/** Logos are stored at 3x their on-screen height; show them at about 2.25rem. */
const LOGO_H = 36;
---

<section id="clients" aria-labelledby="clients-title" class="shell section-gap offscreen-lazy">
  <hgroup>
    <Eyebrow label="Clients" />
    <h2 id="clients-title" class="type-section-display mt-3">
      Who I've built for
    </h2>
  </hgroup>

  <ul role="list" class="clients-grid">
    {clients.map((c) => (
      <li class="client">
        <div class:list={['client-logo', c.darkLogo && 'client-logo--dark']}>
          <Image
            src={c.logo}
            alt={`${c.name} logo`}
            height={LOGO_H}
            densities={[1, 2, 3]}
            format="webp"
            quality={90}
            loading="lazy"
            decoding="async"
            class="logo"
          />
        </div>
        <p class="client-sector">
          <T v={c.sector} />
        </p>
        <h3 class="client-name">{c.name}</h3>
        <p class="client-did">
          <T v={c.did} />
        </p>
        <ul role="list" class="client-tags" aria-label="Work">
          {c.tags.map((t) => (
            <li>
              <T v={t} />
            </li>
          ))}
        </ul>
      </li>
    ))}
    {/*
      Flip card: dark front, signal-yellow back with the call to action. Hover
      (or keyboard focus on its button) turns it; a tap does on touch screens.
    */}
    <li class="client client--next">
      <div class="next-inner">
        <div class="next-face next-front">
          <p class="next-label">Next up</p>
          <h3 class="next-title">Your product could be here.</h3>
          <p class="next-text">
            Cloud, CI/CD, migrations or a site that ranks: let's talk about what you're building.
          </p>
          <p class="next-hint" aria-hidden="true">
            <ArrowRight size={16} stroke-width={2} />
          </p>
        </div>
        <div class="next-face next-back">
          <p class="next-label">Your turn</p>
          <p class="next-title">Start your journey.</p>
          <p class="next-text">
            Tell me what you're running and where it hurts. I'll reply within one working day with
            questions or a plan.
          </p>
          <a class="next-cta" href="/#contact">
            Let's talk
            <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
          </a>
        </div>
      </div>
    </li>
  </ul>
</section>

<style>
  .clients-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  @media (min-width: 40rem) {
    .clients-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .clients-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .client {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: var(--radius-node);
    background: light-dark(#fff, var(--panel));
    box-shadow: 0 12px 26px -22px rgb(15 42 46 / 0.55);
  }

  /* Logo row, then a hairline under it. */
  .client-logo {
    display: flex;
    align-items: center;
    height: 3.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 55%, transparent);
  }
  .client-logo :global(.logo) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 2.25rem;
    object-fit: contain;
    object-position: left center;
  }
  /* Dark-mode panels: a white plate keeps dark-lettered logos readable. */
  :global(:root[data-theme='dark']) .client-logo:not(.client-logo--dark) :global(.logo) {
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: #fff;
    box-sizing: content-box;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .client-logo:not(.client-logo--dark) :global(.logo) {
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
      background: #fff;
      box-sizing: content-box;
    }
  }
  /* Light lettering (Martin Sports): its own colours on a dark plate. */
  .client-logo--dark :global(.logo) {
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    background: #0f2a2e;
    box-sizing: content-box;
  }

  .client-sector {
    margin-top: 1.25rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-stretch: 112%;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .client-name {
    margin-top: 0.375rem;
    font-size: 1.25rem;
    line-height: 1.25;
    font-stretch: 106%;
    font-weight: 680;
  }
  .client-did {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .client-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }
  .client-tags li {
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    background: var(--page);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 560;
  }

  /* ---- The closing flip card ---- */
  .client--next {
    padding: 0;
    background: transparent;
    box-shadow: none;
    perspective: 1400px;
    min-height: 16rem;
  }
  .next-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 700ms var(--ease-out);
  }
  .client--next:hover .next-inner,
  .client--next:focus-within .next-inner {
    transform: rotateY(180deg);
  }
  .next-face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: var(--radius-node);
    backface-visibility: hidden;
    box-shadow: 0 12px 26px -22px rgb(15 42 46 / 0.55);
  }
  .next-front {
    background: var(--band);
    color: #e6efec;
  }
  .next-back {
    background: var(--signal);
    color: var(--on-signal);
    transform: rotateY(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .next-inner {
      transition: none;
    }
  }

  .next-label {
    font-size: 0.75rem;
    font-stretch: 112%;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .next-front .next-label {
    color: var(--signal);
  }
  .next-title {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
    line-height: 1.1;
    font-stretch: 112%;
    font-weight: 780;
  }
  .next-text {
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .next-front .next-text {
    color: #b9cdc9;
  }
  /* A round arrow at the bottom hints that the card turns. */
  .next-hint {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: auto;
    border: 1px solid rgb(230 239 236 / 0.35);
    border-radius: var(--radius-full);
    color: var(--signal);
  }
  /* Dark pill on the yellow back. */
  .next-cta {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    margin-top: auto;
    padding-inline: 1.375rem;
    border-radius: var(--radius-full);
    background: var(--on-signal);
    color: var(--signal);
    font-weight: 600;
    text-decoration: none;
    transition: scale 100ms var(--ease-out);
  }
  .next-cta:active {
    scale: 0.97;
  }
  .next-cta:focus-visible {
    outline: 2px solid var(--on-signal);
    outline-offset: 3px;
  }
</style>
