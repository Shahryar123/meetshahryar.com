---
/**
 * Clients, right after Stats: one row of flip cards that scrolls continuously.
 * Front: the logo on a glass plate. Back (hover / focus): what I did.
 * Edit `clients` below; add as many as you like. `nda: true` redacts the client.
 * `theme` (1-6, yellow → deep teal) cycles automatically when not set.
 *
 * Logos (src/assets/clients/) are pre-processed: margins trimmed, background
 * made transparent, upscaled to 3x their on-screen height and sharpened, so
 * they stay crisp on retina. Each logo's height is picked so every logo covers
 * about the same area: wide wordmarks render shorter.
 * `glass: 'dark'` gives a smoked plate, for logos with light text.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Eyebrow from '@/components/Eyebrow.astro';
import ideasRegistration from '@/assets/clients/ideasregistration.png';
import ideali from '@/assets/clients/ideali.png';
import britishInstruments from '@/assets/clients/britishinstruments.png';
import iqTech from '@/assets/clients/iqtechsol.png';
import martinSports from '@/assets/clients/martinsportsgear.png';

type Theme = 1 | 2 | 3 | 4 | 5 | 6;
interface Client {
  name: string;
  did: string;
  stack?: string[];
  logo?: ImageMetadata;
  glass?: 'light' | 'dark';
  nda?: boolean;
  theme?: Theme;
}

/* PLACEHOLDER details: replace `did` and `stack` with the real ones. */
const clients: Client[] = [
  { name: 'IdeasRegistration', logo: ideasRegistration, did: 'Built and deployed the platform on AWS with automated CI/CD.', stack: ['.NET', 'AWS'] },
  { name: 'Ideali', logo: ideali, did: 'Full-stack features, containerised deployments and monitoring.', stack: ['React', 'Docker'] },
  { name: 'British Instruments', logo: britishInstruments, did: 'Built an AI sales assistant and the cloud setup behind it.', stack: ['Python', 'Azure'] },
  { name: 'IQ Tech Solutions', logo: iqTech, did: 'Web app development and cloud deployment.', stack: ['Node.js', 'AWS'] },
  { name: 'Martin Sports', logo: martinSports, glass: 'dark', did: 'E-commerce storefront, integrations and hosting.', stack: ['React', 'PostgreSQL'] },
];

const themes: Theme[] = [1, 2, 3, 4, 5, 6];
/* Repeat the list inside each loop copy so a copy is always wider than the screen
   (no gap after the last client); ~14 cards x 17rem covers very wide monitors. */
const reps = Math.max(1, Math.ceil(14 / clients.length));
const row = Array.from({ length: reps }, () => clients).flat();
const duration = `${row.length * 6}s`;
---

<section id="clients" aria-labelledby="clients-title" class="shell section-gap offscreen-lazy">
  <div class="clients-head">
    <hgroup>
      <Eyebrow label="Clients" />
      <h2 id="clients-title" class="type-section-display mt-3">Who I've built for</h2>
    </hgroup>
  </div>

  <div class="marquee" style={`--duration:${duration}`}>
    {[false, true].map((copy) => (
      <ul role="list" class="track" aria-hidden={copy ? 'true' : undefined} inert={copy || undefined}>
        {row.map((c, i) => (
          <li class:list={['card', i >= clients.length && 'rep']} aria-hidden={i >= clients.length ? 'true' : undefined} inert={i >= clients.length || undefined} data-theme={c.theme ?? themes[(i % clients.length) % themes.length]} tabindex="0" aria-label={`${c.nda ? 'Confidential client' : c.name}: ${c.did}`}>
            <div class="card-inner">
              <div class="face front" aria-hidden="true">
                <div class:list={['plate', c.glass === 'dark' && 'plate--dark']}>
                  {c.nda || !c.logo ? (
                    <div class="redact">
                      <span /><span />
                    </div>
                  ) : (
                    <Image
                      src={c.logo}
                      alt=""
                      height={Math.round(c.logo.height / 3)}
                      densities={[1, 2, 3]}
                      format="webp"
                      quality={90}
                      loading="lazy"
                      decoding="async"
                      class="logo"
                    />
                  )}
                </div>
              </div>
              <div class="face back" aria-hidden="true">
                <p class="back-label">What I did</p>
                <p class="did">{c.did}</p>
                {c.stack && (
                  <div class="stack">
                    {c.stack.map((s) => <span>{s}</span>)}
                  </div>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .clients-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  /* --- Marquee --- */
  .marquee {
    --gap: 1rem;
    display: flex;
    gap: var(--gap);
    overflow: hidden;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-inline: calc(50% - 50vw);
    padding-block: 0.5rem;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track {
    display: flex;
    flex-shrink: 0;
    gap: var(--gap);
    animation: scroll var(--duration) linear infinite;
  }
  .marquee:hover .track,
  .marquee:focus-within .track {
    animation-play-state: paused;
  }
  @keyframes scroll {
    to {
      translate: calc(-100% - var(--gap)) 0;
    }
  }

  /* --- Card themes: yellow → green → teal → deep teal --- */
  .card {
    --bg: #d9c04f;
    --fg: #0f2a2e;
    --soft: color-mix(in oklab, #0f2a2e 70%, var(--bg));
    --tag-bg: color-mix(in oklab, #0f2a2e 14%, transparent);
    width: 17rem;
    height: 7.5rem;
    flex-shrink: 0;
    perspective: 1000px;
    border-radius: var(--radius-node);
    outline: none;
  }
  .card[data-theme='2'] { --bg: #a3c77d; }
  .card[data-theme='3'] { --bg: #66b08f; }
  .card[data-theme='4'],
  .card[data-theme='5'],
  .card[data-theme='6'] {
    --fg: #ffffff;
    --soft: color-mix(in oklab, #ffffff 72%, var(--bg));
    --tag-bg: color-mix(in oklab, #ffffff 16%, transparent);
  }
  .card[data-theme='4'] { --bg: #2b8277; }
  .card[data-theme='5'] { --bg: #236868; }
  .card[data-theme='6'] { --bg: #1e4f55; }
  .card:focus-visible .card-inner {
    box-shadow: 0 0 0 3px var(--page), 0 0 0 5px var(--signal-ink);
  }

  /* --- Flip --- */
  .card-inner {
    position: relative;
    height: 100%;
    border-radius: inherit;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease-out);
  }
  .card:hover .card-inner,
  .card:focus-visible .card-inner {
    transform: rotateY(180deg);
  }
  .face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 0.875rem 1rem;
    border-radius: inherit;
    background: var(--bg);
    color: var(--fg);
    backface-visibility: hidden;
  }
  .back {
    transform: rotateY(180deg);
    justify-content: center;
  }

  /* --- Front: the logo on a glass plate --- */
  /* Soft light and shade on the card, so the see-through plate reads as glass. */
  .front {
    padding: 0.625rem;
    background:
      radial-gradient(circle at 15% 0%, rgb(255 255 255 / 0.4), transparent 55%),
      radial-gradient(circle at 100% 100%, rgb(0 0 0 / 0.2), transparent 55%),
      var(--bg);
  }
  .plate {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 10px;
    background: linear-gradient(140deg, rgb(255 255 255 / 0.72), rgb(255 255 255 / 0.42));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.8),
      0 10px 24px -14px rgb(0 0 0 / 0.5);
  }
  /* Smoked glass for logos with light text. */
  .plate--dark {
    border-color: rgb(255 255 255 / 0.18);
    background: linear-gradient(140deg, rgb(8 24 20 / 0.62), rgb(8 24 20 / 0.38));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 10px 24px -14px rgb(0 0 0 / 0.6);
  }
  .plate :global(.logo) {
    display: block;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .redact {
    display: grid;
    gap: 0.35rem;
    width: 80%;
  }
  .redact span {
    display: block;
    height: 0.6rem;
    border-radius: 2px;
    background: #0f2a2e;
  }
  .redact span:first-child {
    width: 75%;
  }
  .redact span:last-child {
    width: 40%;
    opacity: 0.6;
  }

  /* --- Back --- */
  .back-label {
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .did {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: 600;
  }
  .stack {
    display: flex;
    gap: 0.3rem;
    margin-top: 0.5rem;
  }
  .stack span {
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--tag-bg);
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  /* Reduced motion: no auto-scroll (swipeable strip), and no 3D flip. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      mask-image: none;
      margin-inline: 0;
    }
    .track {
      animation: none;
    }
    .track[aria-hidden='true'],
    .rep {
      display: none;
    }
    .card-inner {
      transition: none;
    }
  }
</style>
