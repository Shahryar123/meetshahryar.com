---
/**
 * Clients, right after Stats: one row of flip cards that scrolls continuously.
 * Front: initials, tag, name. Back (hover / focus): what I did.
 * Edit `clients` below; add as many as you like. `nda: true` redacts the name.
 * `theme` (1-6, yellow → deep teal) cycles automatically when not set.
 */
import Eyebrow from '@/components/Eyebrow.astro';

type Theme = 1 | 2 | 3 | 4 | 5 | 6;
interface Client {
  name: string;
  tag: string;
  did: string;
  stack?: string[];
  nda?: boolean;
  theme?: Theme;
}

/* PLACEHOLDER details: replace `did`, `tag` and `stack` with the real ones. */
const clients: Client[] = [
  { name: 'IdeasRegistration', tag: 'Cloud', did: 'Migrated the platform to AWS with automated CI/CD.', stack: ['AWS', 'Terraform'] },
  { name: 'Ideall', tag: 'Cloud', did: 'Built containerised deployments and monitoring.', stack: ['Docker', 'Grafana'] },
  { name: 'Confidential retail client', tag: 'NDA', did: 'Scaled e-commerce infrastructure for peak traffic.', stack: ['Azure', 'AKS'], nda: true },
  { name: 'British Instruments', tag: 'Industrial · UK', did: 'Hardened and documented their Azure estate.', stack: ['Azure', 'Bicep'] },
  { name: 'Client Five', tag: 'SaaS', did: 'Kubernetes rollout and cost optimisation.', stack: ['Kubernetes', 'Helm'] },
];

const themes: Theme[] = [1, 2, 3, 4, 5, 6];
/* Repeat the list inside each loop copy so a copy is always wider than the screen
   (no gap after the last client); ~14 cards x 17rem covers very wide monitors. */
const reps = Math.max(1, Math.ceil(14 / clients.length));
const row = Array.from({ length: reps }, () => clients).flat();
/** "British Instruments" → BI, "IdeasRegistration" → IR, "Ideall" → Id. */
const initials = (name: string) => {
  const words = name.split(/\s+/);
  if (words.length > 1) return (words[0][0] + words[1][0]).toUpperCase();
  const caps = name.match(/[A-Z]/g) ?? [];
  return caps.length > 1 ? caps.slice(0, 2).join('') : name.slice(0, 2);
};
const duration = `${row.length * 6}s`;
---

<section id="clients" aria-labelledby="clients-title" class="shell section-gap offscreen-lazy">
  <div class="clients-head">
    <hgroup>
      <Eyebrow label="Clients" />
      <h2 id="clients-title" class="type-section-display mt-3">Who I've built for</h2>
    </hgroup>
  </div>

  <div class="marquee" style={`--duration:${duration}`}>
    {[false, true].map((copy) => (
      <ul role="list" class="track" aria-hidden={copy ? 'true' : undefined} inert={copy || undefined}>
        {row.map((c, i) => (
          <li class:list={['card', i >= clients.length && 'rep']} aria-hidden={i >= clients.length ? 'true' : undefined} inert={i >= clients.length || undefined} data-theme={c.theme ?? themes[(i % clients.length) % themes.length]} tabindex="0" aria-label={`${c.nda ? 'Confidential client' : c.name}: ${c.did}`}>
            <div class="card-inner">
              <div class="face front" aria-hidden="true">
                <div class="row">
                  {c.nda ? (
                    <span />
                  ) : (
                    <span class="mono">{initials(c.name)}</span>
                  )}
                  <span class:list={['tag', c.nda && 'tag--nda']}>{c.tag}</span>
                </div>
                <div class="front-body">
                  {c.nda && (
                    <div class="redact">
                      <span /><span />
                    </div>
                  )}
                  <p class="name">{c.name}</p>
                  <p class="flip-cue">what I did ↻</p>
                </div>
              </div>
              <div class="face back" aria-hidden="true">
                <p class="back-label">What I did</p>
                <p class="did">{c.did}</p>
                {c.stack && (
                  <div class="stack">
                    {c.stack.map((s) => <span>{s}</span>)}
                  </div>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .clients-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  /* --- Marquee --- */
  .marquee {
    --gap: 1rem;
    display: flex;
    gap: var(--gap);
    overflow: hidden;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-inline: calc(50% - 50vw);
    padding-block: 0.5rem;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track {
    display: flex;
    flex-shrink: 0;
    gap: var(--gap);
    animation: scroll var(--duration) linear infinite;
  }
  .marquee:hover .track,
  .marquee:focus-within .track {
    animation-play-state: paused;
  }
  @keyframes scroll {
    to {
      translate: calc(-100% - var(--gap)) 0;
    }
  }

  /* --- Card themes: yellow → green → teal → deep teal --- */
  .card {
    --bg: #d9c04f;
    --fg: #0f2a2e;
    --soft: color-mix(in oklab, #0f2a2e 70%, var(--bg));
    --tag-bg: color-mix(in oklab, #0f2a2e 14%, transparent);
    --mono-bg: #ffffff;
    --mono-fg: #0f2a2e;
    width: 17rem;
    height: 7.5rem;
    flex-shrink: 0;
    perspective: 1000px;
    border-radius: var(--radius-node);
    outline: none;
  }
  .card[data-theme='2'] { --bg: #a3c77d; }
  .card[data-theme='3'] { --bg: #66b08f; }
  .card[data-theme='4'],
  .card[data-theme='5'],
  .card[data-theme='6'] {
    --fg: #ffffff;
    --soft: color-mix(in oklab, #ffffff 72%, var(--bg));
    --tag-bg: color-mix(in oklab, #ffffff 16%, transparent);
  }
  .card[data-theme='4'] { --bg: #2b8277; }
  .card[data-theme='5'] { --bg: #236868; }
  .card[data-theme='6'] { --bg: #1e4f55; }
  .card:focus-visible .card-inner {
    box-shadow: 0 0 0 3px var(--page), 0 0 0 5px var(--signal-ink);
  }

  /* --- Flip --- */
  .card-inner {
    position: relative;
    height: 100%;
    border-radius: inherit;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease-out);
  }
  .card:hover .card-inner,
  .card:focus-visible .card-inner {
    transform: rotateY(180deg);
  }
  .face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 0.875rem 1rem;
    border-radius: inherit;
    background: var(--bg);
    color: var(--fg);
    backface-visibility: hidden;
  }
  .back {
    transform: rotateY(180deg);
    justify-content: center;
  }

  /* --- Front --- */
  .row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .mono {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 8px;
    background: var(--mono-bg);
    color: var(--mono-fg);
    font-size: 0.875rem;
    font-weight: 800;
  }
  .tag {
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--tag-bg);
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
  }
  .tag--nda {
    background: #0f2a2e;
    color: var(--signal) !important;
  }
  .front-body {
    margin-top: auto;
  }
  .redact {
    display: grid;
    gap: 0.3rem;
    margin-bottom: 0.4rem;
  }
  .redact span {
    display: block;
    height: 0.6rem;
    border-radius: 2px;
    background: var(--fg);
  }
  .redact span:first-child {
    width: 75%;
  }
  .redact span:last-child {
    width: 40%;
    opacity: 0.6;
  }
  .name {
    font-size: 1.0625rem;
    line-height: 1.1;
    font-stretch: 118%;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .flip-cue {
    margin-top: 0.35rem;
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  /* --- Back --- */
  .back-label {
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .did {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: 600;
  }
  .stack {
    display: flex;
    gap: 0.3rem;
    margin-top: 0.5rem;
  }
  .stack span {
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--tag-bg);
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  /* Reduced motion: no auto-scroll (swipeable strip), and no 3D flip. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      mask-image: none;
      margin-inline: 0;
    }
    .track {
      animation: none;
    }
    .track[aria-hidden='true'],
    .rep {
      display: none;
    }
    .card-inner {
      transition: none;
    }
  }
</style>
