---
import MenuIcon from '@lucide/astro/icons/menu';
import XIcon from '@lucide/astro/icons/x';
import BrandIcon from './BrandIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getSite } from '@/lib/site';
import { isHttpUrl } from '@/lib/todo';

const site = await getSite();
/* Profiles, shown before the theme toggle. A link still in [brackets] is left out. */
const socials = (
  [
    { href: site.links.github, label: 'GitHub', icon: 'github', size: 18 },
    { href: site.links.linkedin, label: 'LinkedIn', icon: 'linkedin', size: 17 },
  ] as const
).filter((s) => isHttpUrl(s.href));

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#services', label: 'Services' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 bg-page">
  <nav aria-label="Main" class="shell flex h-(--header-h) items-center gap-10">
    <a href="/" class="monogram" aria-label="Shahryar, home">
      S
    </a>
    <ul role="list" class="hidden items-center gap-7 lg:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="type-control text-muted hover:text-ink">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="ml-auto flex items-center gap-2">
      <div class="nav-pill hidden lg:flex">
        {socials.map((s) => (
          <a href={s.href} class="nav-icon" aria-label={s.label}>
            <BrandIcon name={s.icon} size={s.size} />
          </a>
        ))}
        <ThemeToggle />
      </div>
      <a href="/#contact" class="btn btn-secondary min-h-10 px-4">
        Let's talk
      </a>
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-chip text-ink lg:hidden"
        aria-label="Open menu"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-open
      >
        <MenuIcon size={24} stroke-width={1.75} aria-hidden="true" />
      </button>
    </div>
  </nav>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu">
  <div class="shell flex h-(--header-h) items-center">
    <a href="/" class="monogram" aria-label="Shahryar, home">
      S
    </a>
    <button
      type="button"
      class="ml-auto inline-flex size-10 items-center justify-center rounded-chip text-ink"
      aria-label="Close menu"
      data-menu-close
    >
      <XIcon size={24} stroke-width={1.75} aria-hidden="true" />
    </button>
  </div>
  <nav aria-label="Menu" class="shell mt-6">
    <ul role="list" class="flex flex-col gap-1">
      {links.map((link) => (
        <li>
          <a href={link.href} class="type-h2 block py-2">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <ThemeToggle withLabel />
      {socials.map((s) => (
        <a href={s.href} class="btn btn-secondary size-12 px-0" aria-label={s.label}>
          <BrandIcon name={s.icon} size={s.size + 2} />
        </a>
      ))}
    </div>
  </nav>
</dialog>

<style>
  .monogram {
    font-size: 1.625rem;
    line-height: 1;
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  /*
   * GitHub, LinkedIn and the theme toggle share one pill: hovering (or tabbing
   * to) any of them brings up a single green capsule behind all three. It is
   * keyboard focus only (:focus-visible), so a mouse click doesn't leave it on.
   * The capsule is the same deep green in both themes, so light icons and the
   * yellow theme icon read on it either way.
   */
  .nav-pill {
    --pill: #1f6f6a; /* the light theme's accent */
    --on-pill: #e6efec;
    position: relative;
    align-items: center;
    padding-inline: 0.25rem;
  }
  .nav-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    background: var(--pill);
    opacity: 0;
    scale: 0.85 0.7;
    transition:
      opacity 0.22s ease,
      scale 0.35s var(--ease-out);
  }
  .nav-pill:is(:hover, :has(:focus-visible))::before {
    opacity: 1;
    scale: 1;
  }
  .nav-pill :global([data-theme-toggle]) {
    position: relative; /* above the capsule */
    border-radius: var(--radius-full);
    transition:
      color 0.22s ease,
      scale 0.25s var(--ease-out);
  }
  .nav-icon {
    position: relative; /* above the capsule */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    border-radius: var(--radius-full);
    color: var(--muted);
    transition:
      color 0.22s ease,
      scale 0.25s var(--ease-out);
  }
  /*
   * On the capsule: light brand icons and a signal-yellow moon/sun. The toggle
   * is ThemeToggle's markup, so it's reached with :global() (kept out of :is(),
   * where Astro's scoping doesn't apply it).
   */
  .nav-pill:hover .nav-icon,
  .nav-pill:has(:focus-visible) .nav-icon {
    color: var(--on-pill);
  }
  .nav-pill:hover :global([data-theme-toggle]),
  .nav-pill:has(:focus-visible) :global([data-theme-toggle]) {
    color: var(--signal);
  }
  .nav-icon:hover,
  .nav-pill :global([data-theme-toggle]:hover) {
    scale: 1.1;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-pill::before,
    .nav-icon,
    .nav-pill :global([data-theme-toggle]) {
      transition: none;
    }
    .nav-icon:hover,
    .nav-pill :global([data-theme-toggle]:hover) {
      scale: none;
    }
  }
  .mobile-menu {
    margin: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    background: var(--page);
    color: var(--ink);
  }
  .mobile-menu::backdrop {
    background: var(--page);
  }
</style>

<script>
  // Native <dialog>: showModal() traps focus and Esc closes it.
  function init() {
    const dialog = document.getElementById('mobile-menu');
    const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    if (!(dialog instanceof HTMLDialogElement) || !opener) return;

    opener.addEventListener('click', () => {
      dialog.showModal();
      opener.setAttribute('aria-expanded', 'true');
    });
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('close', () => opener.setAttribute('aria-expanded', 'false'));

    // If the window grows to desktop width while the menu is open, close it.
    const desktop = matchMedia('(min-width: 64rem)');
    desktop.addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
