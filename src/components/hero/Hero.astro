---
/**
 * Hero: name, title, value line and CTAs on the left; the brush-stroke portrait
 * on the right, tucked under the end of the name. Below, one
 * card per category, each linking to its service row.
 */
import Download from '@lucide/astro/icons/download';
import CategoryIcon from '@/components/CategoryIcon.astro';
import Photo from '@/components/Photo.astro';
import { CATEGORIES } from '@/lib/categories';
import { heroPhoto, heroPhotoOnDark } from '@/lib/photo';
import { getSite } from '@/lib/site';

const site = await getSite();
const artSizes = '(min-width: 64rem) 46vw, (min-width: 40rem) 32rem, 92vw';
const artWidths = [480, 720, 1000];
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-top">
    <div class="hero-text">
      <h1 id="hero-title">
        <span class="type-display block">{site.firstName}</span>
        <span class="sr-only">, </span>
        <span class="hero-role mt-4 block">{site.title}</span>
      </h1>
      <p class="hero-value type-lead mt-6">{site.valueLine}</p>
      <div class="hero-actions mt-8">
        <a class="btn btn-primary" href="#work">
          See my work
        </a>
        <a class="btn btn-secondary" href="/cv.pdf" download>
          <Download size={18} stroke-width={1.75} aria-hidden="true" />
          Download CV (PDF)
        </a>
      </div>
    </div>

    <!-- Light page: original dark paint. Dark page: the copy with lifted paint. -->
    <div class="hero-art">
      <div class="art art-light">
        <Photo image={heroPhoto} priority widths={artWidths} sizes={artSizes} />
      </div>
      {heroPhotoOnDark && (
        <div class="art art-dark">
          <Photo image={heroPhotoOnDark} priority widths={artWidths} sizes={artSizes} />
        </div>
      )}
    </div>
  </div>

  <div class="hero-services">
    <ul role="list" class="cards" aria-label="What I work on">
      {CATEGORIES.map((c) => (
        <li>
          <a class="card" href={`#service-${c.id}`}>
            <span class="card-icon" aria-hidden="true">
              <CategoryIcon id={c.id} size={20} />
            </span>
            <span>{c.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(0.5rem, 0.25rem + 1vw, 1.25rem);
  }

  /* ---- top: stacked under 1024px, side by side above ---- */
  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2rem;
  }
  .hero-text {
    position: relative;
    z-index: 1; /* the name runs over the edge of the paint */
  }
  .hero-role {
    font-size: clamp(1.375rem, 1rem + 1.4vw, 2.125rem);
    line-height: 1.15;
    font-stretch: 118%;
    font-weight: 680;
  }
  .hero-value {
    max-width: 36rem;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero-art {
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    aspect-ratio: 1000 / 860;
  }
  .art {
    height: 100%;
  }
  .art-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .art-light:has(+ .art-dark) {
      display: none;
    }
    :root:not([data-theme='light']) .art-dark {
      display: block;
    }
  }
  :root[data-theme='dark'] .art-light:has(+ .art-dark) {
    display: none;
  }
  :root[data-theme='dark'] .art-dark {
    display: block;
  }

  @media (max-width: 39.99rem) {
    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 64rem) {
    .hero-top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      align-items: center;
    }
    .hero-text {
      grid-row: 1;
      grid-column: 1 / 8;
    }
    /* Starts one column inside the text, so the paint sits under the name's end. */
    .hero-art {
      grid-row: 1;
      grid-column: 7 / 13;
      max-width: none;
      /* Pull the image up past the transparent band above the paint. */
      margin-top: -3rem;
    }
  }

  /* ---- what I work on ---- */
  .hero-services {
    margin-top: clamp(1.25rem, 0.75rem + 1vw, 1.75rem);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    height: 100%;
    min-height: 4.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-node);
    background: var(--panel);
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.15;
    font-stretch: 106%;
    font-weight: 620;
    transition: color 180ms var(--ease-out);
  }
  .card:hover {
    color: var(--signal-ink);
  }
  .card-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: #0f2a2e;
    color: var(--signal);
  }
</style>
