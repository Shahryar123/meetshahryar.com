---
/**
 * Hero: name, title, value line and CTAs on the left; the brush-stroke portrait
 * on the right, tucked under the end of the name.
 */
import Download from '@lucide/astro/icons/download';
import Photo from '@/components/Photo.astro';
import { heroPhoto, heroPhotoOnDark } from '@/lib/photo';
import { getSite } from '@/lib/site';

const site = await getSite();
const artSizes = '(min-width: 64rem) 46vw, (min-width: 40rem) 32rem, 92vw';
const artWidths = [480, 720, 1000];

/*
 * The name, split for the load sequence: words (kept unbreakable) of letters,
 * each with its running index for the stagger.
 */
let index = 0;
const words = [site.firstName, site.surname]
  .filter(Boolean)
  .map((word) => [...word].map((ch) => ({ ch, i: index++ })));
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-top">
    <div class="hero-text">
      <h1 id="hero-title">
        <span class="hero-name type-display block">
          <span class="sr-only">
            {site.firstName} {site.surname}
          </span>
          {/*
            Load sequence: each letter's slot is locked to its final (wide) width by
            an invisible copy; the visible copy on top settles from condensed to wide.
            Nothing around it moves, so there's no layout shift.
          */}
          <span aria-hidden="true">
            {words.map((letters, w) => (
              <>
                {w > 0 && ' '}
                <span class="name-word">
                  {letters.map((l) => (
                    <span class="name-slot" style={`--i: ${l.i}`}>
                      <span class="name-fit">{l.ch}</span>
                      <span class="name-glyph">{l.ch}</span>
                    </span>
                  ))}
                </span>
              </>
            ))}
          </span>
        </span>
        <span class="sr-only">, </span>
        <span class="hero-role mt-4 block">{site.title}</span>
      </h1>
      <p class="hero-value type-lead mt-6">{site.valueLine}</p>
      <div class="hero-actions mt-8">
        <a class="btn btn-primary" href="#work" data-magnetic>
          See my work
        </a>
        <a
          class="btn btn-secondary"
          href="/Muhammad_Shahryar_Software_Engineer.pdf"
          download
          data-magnetic
        >
          <Download size={18} stroke-width={1.75} aria-hidden="true" />
          Download CV (PDF)
        </a>
      </div>
    </div>

    {/* Light page: original dark paint. Dark page: the copy with lifted paint. */}
    <div class="hero-art">
      <div class="art art-light">
        <Photo image={heroPhoto} priority widths={artWidths} sizes={artSizes} />
      </div>
      {heroPhotoOnDark && (
        <div class="art art-dark">
          <Photo image={heroPhotoOnDark} priority widths={artWidths} sizes={artSizes} />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(0.5rem, 0.25rem + 1vw, 1.25rem);
  }

  /* ---- top: stacked under 1024px, side by side above ---- */
  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2rem;
  }
  .hero-text {
    position: relative;
    z-index: 1; /* the name runs over the edge of the paint */
  }
  /*
   * "Muhammad" is about 6.7em wide: on small phones, scale it with the screen so
   * it fits (13.4vw), but never above the usual display size.
   */
  .hero-name {
    font-size: min(13.4vw, clamp(3.25rem, 9vw, 9rem));
  }
  .hero-role {
    font-size: clamp(1.375rem, 1rem + 1.4vw, 2.125rem);
    line-height: 1.15;
    font-stretch: 118%;
    font-weight: 680;
  }
  .hero-value {
    max-width: 36rem;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero-art {
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    aspect-ratio: 1000 / 860;
  }
  .art {
    height: 100%;
  }
  .art-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .art-light:has(+ .art-dark) {
      display: none;
    }
    :root:not([data-theme='light']) .art-dark {
      display: block;
    }
  }
  :root[data-theme='dark'] .art-light:has(+ .art-dark) {
    display: none;
  }
  :root[data-theme='dark'] .art-dark {
    display: block;
  }

  @media (max-width: 39.99rem) {
    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 64rem) {
    .hero-top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      align-items: center;
    }
    .hero-text {
      grid-row: 1;
      grid-column: 1 / 8;
    }
    /* "Muhammad" is wider than one name was; keep it to the text column so it only grazes the paint. */
    .hero-name {
      font-size: clamp(3.25rem, 7.4vw, 7.5rem);
    }
    /* Starts one column inside the text, so the paint sits under the name's end. */
    .hero-art {
      grid-row: 1;
      grid-column: 7 / 13;
      max-width: none;
      /* Pull the image up past the transparent band above the paint. */
      margin-top: -3rem;
    }
  }

  /* ---- the name's letters (see the markup note) ---- */
  .name-word {
    white-space: nowrap; /* letters are inline-blocks: don't break inside a word */
  }
  .name-slot {
    position: relative;
    display: inline-block;
  }
  .name-fit {
    visibility: hidden;
  }
  .name-glyph {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
  }

  /*
   * ---- load sequence (~1.3s, once per page load) ----
   * Portrait wipes in 0-750ms; the name settles 100-1150ms, 30ms per letter;
   * title, value line and buttons follow. Reduced motion: final state at once.
   */
  @media (prefers-reduced-motion: no-preference) {
    .name-glyph {
      animation: name-settle 700ms var(--ease-out) both;
      animation-delay: calc(100ms + var(--i) * 30ms);
    }
    .hero-art {
      animation: art-wipe 750ms var(--ease-out) both;
    }
    .hero-art :global(img) {
      animation: art-settle 1100ms var(--ease-out) both;
    }
    .hero-role,
    .hero-value,
    .hero-actions {
      animation: rise 600ms var(--ease-out) both;
    }
    .hero-role {
      animation-delay: 450ms;
    }
    .hero-value {
      animation-delay: 580ms;
    }
    .hero-actions {
      animation-delay: 700ms;
    }
  }
  @keyframes name-settle {
    from {
      font-stretch: 75%;
      opacity: 0.35;
    }
    to {
      font-stretch: 125%;
      opacity: 1;
    }
  }
  /* Starts a quarter visible, so the portrait is on screen from the first frame. */
  @keyframes art-wipe {
    from {
      clip-path: inset(0 75% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes art-settle {
    from {
      scale: 1.06;
    }
    to {
      scale: 1;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
    to {
      opacity: 1;
      translate: none;
    }
  }
</style>
