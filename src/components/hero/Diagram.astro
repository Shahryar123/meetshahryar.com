---
/**
 * The hero's architecture diagram: your photo as the origin node, six service
 * nodes wired to it with orthogonal, rounded-elbow connectors.
 * Geometry lives in src/lib/diagram.ts. Each node links to its service row.
 *
 * Phase 3 adds the load sequence, packets and hover lighting; the markup here
 * is already the final state, so reduced motion and no-JS look the same.
 */
import { getCollection } from 'astro:content';
import CategoryIcon from '@/components/CategoryIcon.astro';
import Photo from '@/components/Photo.astro';
import { heroPhoto, heroPhotoOnDark } from '@/lib/photo';
import T from '@/components/T.astro';
import { CATEGORIES } from '@/lib/categories';
import {
  NARROW,
  N_PORT_X,
  N_PORT_Y,
  PHOTO,
  PHOTO_PORTS,
  WIDE,
  WIDE_LAYOUT,
  narrowPath,
  pct,
} from '@/lib/diagram';

const services = await getCollection('services');
const nodes = CATEGORIES.map((category, index) => ({
  ...category,
  index,
  layout: WIDE_LAYOUT[category.id],
  tooltip: services.find((s) => s.id === category.id)?.data.tooltip ?? '[tooltip]',
}));

const photoBox = [
  `--l:${pct(PHOTO.x, WIDE.w)}`,
  `--t:${pct(PHOTO.y, WIDE.h)}`,
  `--w:${pct(PHOTO.w, WIDE.w)}`,
  `--h:${pct(PHOTO.h, WIDE.h)}`,
].join(';');
---

<div class="diagram" data-diagram>
  <svg
    class="links links-wide"
    viewBox={`0 0 ${WIDE.w} ${WIDE.h}`}
    aria-hidden="true"
    focusable="false"
  >
    {nodes.map((n) => (
      <path class="link" data-link={n.id} d={n.layout.path} />
    ))}
  </svg>
  <svg
    class="links links-narrow"
    viewBox={`0 0 ${NARROW.w} ${NARROW.h}`}
    width={NARROW.w}
    height={NARROW.h}
    aria-hidden="true"
    focusable="false"
  >
    {nodes.map((n) => (
      <path class="link" data-link={n.id} d={narrowPath(n.index)} />
    ))}
  </svg>

  <!-- The origin node: the brush-stroke portrait, shown whole on its transparent canvas. -->
  <div class="photo-node" style={photoBox}>
    <div class="art art-light">
      <Photo
        image={heroPhoto}
        priority
        widths={[240, 480, 720]}
        sizes="(min-width: 48rem) 240px, 120px"
      />
    </div>
    {heroPhotoOnDark && (
      <div class="art art-dark">
        <Photo
          image={heroPhotoOnDark}
          priority
          widths={[240, 480, 720]}
          sizes="(min-width: 48rem) 240px, 120px"
        />
      </div>
    )}
  </div>

  <!-- Terminals where the connectors meet the paint. -->
  {PHOTO_PORTS.map((p) => (
    <span
      class="port port-wide"
      style={`--x:${pct(p.x, WIDE.w)};--y:${pct(p.y, WIDE.h)}`}
      aria-hidden="true"
    />
  ))}
  <span class="port port-narrow" style={`--x:${N_PORT_X}px;--y:${N_PORT_Y}px`} aria-hidden="true" />

  <ul role="list" class="nodes" aria-label="What I do">
    {nodes.map((n) => (
      <li
        class="node-item"
        data-place={n.layout.place}
        style={`--x:${pct(n.layout.x, WIDE.w)};--y:${pct(n.layout.y, WIDE.h)}`}
      >
        <a class="node" href={`#service-${n.id}`} data-node={n.id} aria-describedby={`tip-${n.id}`}>
          <CategoryIcon id={n.id} size={18} />
          <span>{n.label}</span>
        </a>
        <span class="tip type-small" id={`tip-${n.id}`} role="tooltip">
          <T v={n.tooltip} />
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  /* ---- narrow: photo left, one trunk, six rows (under 768px) ---- */
  .diagram {
    position: relative;
    display: grid;
    grid-template-columns: 120px 24px minmax(0, 1fr);
  }
  .links {
    pointer-events: none;
    overflow: visible;
  }
  .link {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }
  .links-wide {
    display: none;
  }
  .links-narrow {
    position: absolute;
    top: 0;
    left: 0;
  }
  .photo-node {
    position: relative;
    z-index: 1;
    grid-row: 1;
    grid-column: 1;
    width: 120px;
    height: 148px;
  }
  /* Light page: original dark paint. Dark page: the lifted copy. */
  .art {
    height: 100%;
  }
  .art-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .art-light:has(+ .art-dark) {
      display: none;
    }
    :root:not([data-theme='light']) .art-dark {
      display: block;
    }
  }
  :root[data-theme='dark'] .art-light:has(+ .art-dark) {
    display: none;
  }
  :root[data-theme='dark'] .art-dark {
    display: block;
  }
  .port {
    position: absolute;
    z-index: 2;
    left: var(--x);
    top: var(--y);
    width: 10px;
    height: 10px;
    translate: -50% -50%;
    border: 2px solid var(--rule);
    border-radius: var(--radius-full);
    background: var(--page);
    pointer-events: none;
  }
  .port-wide {
    display: none;
  }
  .nodes {
    grid-row: 1;
    grid-column: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .node {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 44px;
    padding-inline: 0.875rem;
    border-radius: var(--radius-node);
    background: var(--panel);
    color: var(--ink);
    white-space: nowrap;
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1;
    font-stretch: 104%;
    font-weight: 560;
  }
  .node :global(svg) {
    color: var(--muted);
  }
  .node:hover,
  .node:hover :global(svg) {
    color: var(--signal-ink);
  }
  .tip {
    display: none;
  }

  /* ---- wide: the full diagram, scaled as one piece (768px and up) ---- */
  @media (min-width: 48rem) {
    .diagram {
      display: block;
      width: 100%;
      max-width: 40rem;
      aspect-ratio: 640 / 440;
    }
    .links-wide {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .links-narrow,
    .port-narrow {
      display: none;
    }
    .port-wide {
      display: block;
    }
    .photo-node {
      position: absolute;
      left: var(--l);
      top: var(--t);
      width: var(--w);
      height: var(--h);
    }
    .nodes {
      display: block;
    }
    .node-item {
      position: absolute;
      left: var(--x);
      top: var(--y);
    }
    /* A node grows away from its anchor, so long labels never move a connector. */
    .node-item[data-place='above'] {
      translate: -50% -100%;
    }
    .node-item[data-place='below'] {
      translate: -50% 0;
    }
    .node-item[data-place='left'] {
      translate: -100% -50%;
    }
    .node-item[data-place='right'] {
      translate: 0 -50%;
    }

    .tip {
      position: absolute;
      z-index: 2;
      width: max-content;
      max-width: 17rem;
      padding: 0.5rem 0.75rem;
      border-radius: var(--radius-chip);
      background: var(--ink);
      color: var(--page);
    }
    .node-item:has(.node:hover, .node:focus-visible) .tip {
      display: block;
    }
    [data-place='above'] .tip {
      bottom: calc(100% + 0.5rem);
      left: 50%;
      translate: -50% 0;
    }
    [data-place='below'] .tip {
      top: calc(100% + 0.5rem);
      left: 50%;
      translate: -50% 0;
    }
    [data-place='left'] .tip {
      top: calc(100% + 0.5rem);
      right: 0;
    }
    [data-place='right'] .tip {
      top: calc(100% + 0.5rem);
      left: 0;
    }
  }
</style>
