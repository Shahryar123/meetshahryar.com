---
/**
 * Your photo, or a visible placeholder until src/assets/me.* exists.
 *
 * Both images are finished artwork on a transparent canvas, so they're shown
 * whole (contain, never cropped), with no frame or tint, and keep their
 * transparency in every format.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photo as defaultPhoto, PHOTO_ALT } from '@/lib/photo';

interface Props {
  /** Defaults to src/assets/me.*. */
  image?: ImageMetadata;
  sizes: string;
  widths: number[];
  /** The hero copy loads first; the About copy waits until it's near. */
  priority?: boolean;
}
const { image, sizes, widths, priority = false } = Astro.props;
const photo = image ?? defaultPhoto;
// Never ask for a width larger than the source.
const maxWidth = photo?.width ?? Infinity;
const safeWidths = [...new Set(widths.map((w) => Math.min(w, maxWidth)))];
---

{photo ? (
  <Picture
    src={photo}
    alt={PHOTO_ALT}
    formats={['avif']}
    fallbackFormat="webp"
    widths={safeWidths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class="block h-full w-full object-contain"
  />
) : (
  <div class="grid h-full w-full place-items-center rounded-(--radius-node) bg-panel p-3 text-center">
    <span class="todo type-small">[your photo]</span>
  </div>
)}
