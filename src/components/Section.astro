---
/**
 * A home-page section: an eyebrow label (with the yellow bar) over the heading,
 * and at most one plain sentence under it.
 */
import Eyebrow from '@/components/Eyebrow.astro';

interface Props {
  id: string;
  title: string;
  /** Short label above the heading, e.g. "Always learning". Shown in capitals. */
  eyebrow: string;
  intro?: string;
  /** "display" uses the large, heavy heading (type-section-display). */
  size?: 'default' | 'display';
  class?: string;
}
const { id, title, eyebrow, intro, size = 'default', class: className } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={['shell section-gap', className]}>
  <hgroup>
    <Eyebrow label={eyebrow} />
    <h2
      id={`${id}-title`}
      class:list={[size === 'display' ? 'type-section-display' : 'type-h2', 'mt-3']}
    >
      {title}
    </h2>
  </hgroup>
  {intro && <p class="type-lead mt-4 max-w-[46ch] text-muted">{intro}</p>}
  <div class="mt-10 md:mt-14">
    <slot />
  </div>
</section>
