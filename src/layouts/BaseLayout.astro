---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import { getSite } from '@/lib/site';
import { clean } from '@/lib/todo';

interface Props {
  title: string;
  description: string;
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** Share image (1200×630) for link previews. Defaults to /og-image.png (`npm run images`). */
  image?: { src: string; alt: string };
}
const {
  title,
  description,
  noindex = false,
  image = { src: '/og-image.png', alt: `${title}: name, title and photo` },
} = Astro.props;
const site = await getSite();
const siteName = [site.firstName, clean(site.surname)].filter(Boolean).join(' ');
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Link previews (LinkedIn, WhatsApp, Slack, X). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <meta name="theme-color" content="#0f2a2e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#e6efec" media="(prefers-color-scheme: light)" />
    <Font cssVariable="--font-mona" preload />
    {/* Apply a saved theme before first paint, so there's no flash. */}
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch {
        /* storage blocked: follow the OS preference */
      }
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <script>
      import '@/scripts/button-feel';
    </script>
  </body>
</html>
